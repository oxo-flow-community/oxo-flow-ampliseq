[[rules]]
name = "sintax_format_tax"
description = "Convert SINTAX tabbed output into a per-ASV taxonomy table"
when = "config.sintax_ref_tax_custom != \"\""
input = [
    "intermediates/sintax/ASV_tax.sintax.tsv",
