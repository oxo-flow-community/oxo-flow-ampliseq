# Summary report: gate opens for ANY taxonomy winner (upstream
# phyloseq.join of all present R-objects); DADA2 inputs stay in the
# input array because the template always renders the DADA2 sections
# from them.
[[rules]]
name = "summary_report"
description = "Rmd summary report over QC, DADA2, taxonomy, SBDI and R-object results"
when = "!config.skip_report && !config.skip_taxonomy && (!config.skip_dada_taxonomy || (config.pplace_tree != \"\" && config.pplace_taxonomy != \"\") || config.sintax_ref_tax_custom != \"\" || config.kraken2_ref_tax_custom != \"\" || config.qiime_ref_taxonomy != \"\" || config.classifier != \"\" || config.vsearch_lca_ref_tax_custom != \"\")"
input = [
    "assets/report_template.Rmd",
    "assets/nf-core_style.css",
    "assets/nf-core-ampliseq_logo_light_long.png",
    "results/dada2/ASV_table.tsv",
    "results/dada2/ASV_tax_species.sbdi-gtdb_R11-RS232-1.tsv",
    "results/dada2/DADA2_stats.tsv",
    "results/dada2/DADA2_table.tsv",
    "results/dada2/QC/svg/FW_qual_stats.svg",
    "results/dada2/QC/svg/RV_qual_stats.svg",
    "results/dada2/QC/svg/FW_preprocessed_qual_stats.svg",
    "results/dada2/QC/svg/RV_preprocessed_qual_stats.svg",
    "results/dada2/QC/svg/{config.run_id}_1.err.svg",
    "results/dada2/QC/svg/{config.run_id}_2.err.svg",
    "results/cutadapt/cutadapt_summary.tsv",
    "{config.metadata_file}",
]
expand_inputs = [
    { pattern = "results/dada2/args/{sample}.filterAndTrim.args.txt", variables = { sample = "config.samples_list" } },
]
output = [
    "results/summary_report/summary_report.html",
]
shell = '''
mkdir -p work/summary_report results/summary_report
cp {input[0]} work/summary_report/template.Rmd
cp {input[1]} work/summary_report/nf-core_style.css
cp {input[2]} work/summary_report/nf-core-ampliseq_logo_light_long.png
cp {input[3]} work/summary_report/ASV_table.tsv
cp {input[4]} work/summary_report/ASV_tax_species.tsv
cp {input[5]} work/summary_report/DADA2_stats.tsv
cp {input[6]} work/summary_report/DADA2_table.tsv
cp {input[7]} work/summary_report/FW_qual_stats.svg
cp {input[8]} work/summary_report/RV_qual_stats.svg
cp {input[9]} work/summary_report/FW_preprocessed_qual_stats.svg
cp {input[10]} work/summary_report/RV_preprocessed_qual_stats.svg
cp {input[11]} work/summary_report/{config.run_id}_1.err.svg
cp {input[12]} work/summary_report/{config.run_id}_2.err.svg
cp {input[13]} work/summary_report/cutadapt_summary.tsv
cp {input[14]} work/summary_report/metadata.tsv
cp {input[15]} work/summary_report/filterAndTrim.args.txt
cd work/summary_report
TRUNCLENF=$(cat ../../intermediates/dada2/trunclenf.txt 2>/dev/null || echo 'null')
TRUNCLENR=$(cat ../../intermediates/dada2/trunclenr.txt 2>/dev/null || echo 'null')
params=()
params+=("css='nf-core_style.css'")
params+=("report_logo='nf-core-ampliseq_logo_light_long.png'")
params+=("workflow_manifest_version='2.18.0'")
params+=("metadata='metadata.tsv'")
params+=("cutadapt_summary='cutadapt_summary.tsv'")
params+=("truncq={config.truncq}")
if [ "$TRUNCLENF" != "null" ]; then
    params+=("trunc_qmin={config.trunc_qmin},trunc_rmin={config.trunc_rmin}")
    params+=("trunclenf='$TRUNCLENF'")
    params+=("trunclenr='$TRUNCLENR'")
fi
params+=("max_ee={config.max_ee}")
params+=("dada_qc_f_path='FW_qual_stats.svg',dada_qc_r_path='RV_qual_stats.svg',dada_pp_qc_f_path='FW_preprocessed_qual_stats.svg',dada_pp_qc_r_path='RV_preprocessed_qual_stats.svg'")
params+=("dada_filtntrim_args='filterAndTrim.args.txt'")
params+=("dada_sample_inference='{config.sample_inference}'")
params+=("dada_err_path='{config.run_id}_1.err.svg,{config.run_id}_2.err.svg',dada_err_run='{config.run_id}'")
params+=("asv_table_path='ASV_table.tsv'")
params+=("path_dada2_tab='DADA2_table.tsv'")
params+=("dada_stats_path='DADA2_stats.tsv'")
params+=("mergepairs_strategy='{config.mergepairs_strategy}'")
params+=("min_len_asv=0,max_len_asv=0")
params+=("dada_min_boot={config.dada_min_boot}")
if [ "{config.cut_its}" != "none" ] && [ -f ../../results/itsx/ASV_ITS_seqs.summary.txt ]; then
    cp ../../results/itsx/ASV_ITS_seqs.summary.txt itsx_cutasv_summary.txt
    params+=("itsx_cutasv_summary='itsx_cutasv_summary.txt',cut_its='{config.cut_its}'")
fi
params+=("dada2_taxonomy='ASV_tax_species.tsv'")
params+=("dada2_ref_tax_title='{config.dada_ref_taxonomy_title}',dada2_ref_tax_file='{config.dada_ref_taxonomy_urls}',dada2_ref_tax_citation='{config.dada_ref_taxonomy_citation}'")
if [ -f ../../results/SBDI/annotation.tsv ]; then
    cp ../../results/SBDI/event.tsv ../../results/SBDI/dna.tsv ../../results/SBDI/emof.tsv ../../results/SBDI/asv-table.tsv ../../results/SBDI/annotation.tsv .
    mkdir -p sbdi
    mv event.tsv dna.tsv emof.tsv asv-table.tsv annotation.tsv sbdi/
    params+=("sbdi='sbdi/event.tsv,sbdi/dna.tsv,sbdi/emof.tsv,sbdi/asv-table.tsv,sbdi/annotation.tsv'")
fi
# R-objects: comma-join EVERY present RDS (dada2 + alt tools) into the
# single phyloseq=/tse= param — upstream phyloseq.join(",") takes one
# comma-joined path list per object type.
ro_phyloseq=""
for f in ../../results/phyloseq/*_phyloseq.rds; do
    [ -f "$f" ] || continue
    mkdir -p phyloseq
    cp "$f" phyloseq/
    ro_phyloseq="${ro_phyloseq:+${ro_phyloseq},}phyloseq/$(basename "$f")"
done
if [ -n "$ro_phyloseq" ]; then
    params+=("phyloseq='$ro_phyloseq'")
fi
ro_tse=""
for f in ../../results/treesummarizedexperiment/*_TreeSummarizedExperiment.rds; do
    [ -f "$f" ] || continue
    mkdir -p tse
    cp "$f" tse/
    ro_tse="${ro_tse:+${ro_tse},}tse/$(basename "$f")"
done
if [ -n "$ro_tse" ]; then
    params+=("tse='$ro_tse'")
fi
params_string=$(IFS=,; echo "${params[*]}")
Rscript - <<REOF
library(rmarkdown)
file.copy("./template.Rmd", "./template_copy.Rmd", overwrite = TRUE)
rmarkdown::render("template_copy.Rmd", output_file = "summary_report.html", params = list(${params_string}), envir = new.env())
REOF
cp summary_report.html "$OLDPWD/results/summary_report/summary_report.html"
'''
tags = ["reporting"]

[rules.environment]
conda = "envs/report.yaml"

[rules.resources]
threads = 2
memory = "3G"

# ------------------------------------------------------------------
# R55  PPLACE_CLUSTALO_ALIGN  (nf-core/clustalo/align, clustalo branch)
#      Align the ASV sequences (query) against the user-supplied
#      reference alignment (profile1) with clustalo. Upstream
#      FASTA_NEWICK_EPANG_GAPPA selects the alignmethod via
#      params.pplace_alnmethod; the port implements the clustalo
#      branch (mafft/hmmer variants excluded — see README).
#      The empty fhmm/fhmm_batch inputs of upstream's CLUSTALO_ALIGN
#      are dropped (no HMMER branch here), profile2 is unused.
# ------------------------------------------------------------------
[[rules]]
name = "pplace_clustalo_align"
description = "Align ASVs against the reference alignment with clustalo (PPLACE placement input)"
when = "config.pplace_tree != \"\""
input = ["results/dada2/ASV_seqs.fasta", "{config.pplace_aln}"]
output = ["intermediates/pplace/ASV.aln.fa.gz"]
shell = '''
mkdir -p work/pplace_clustalo_align intermediates/pplace
cp {input[0]} work/pplace_clustalo_align/query.fasta
cp {input[1]} work/pplace_clustalo_align/refseq.fasta
cd work/pplace_clustalo_align
clustalo -i query.fasta --profile1 refseq.fasta --threads={threads} --force -o >(pigz -cp {threads} > "$OLDPWD/intermediates/pplace/ASV.aln.fa.gz")
'''
tags = ["pplace", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/mulled-v2-4cefc38542f86c17596c29b35a059de10387c6a7:adbe4fbad680f9beb083956d79128039a727e7b3-0"

[rules.resources]
threads = 2
memory = "4G"

# ------------------------------------------------------------------
# R56  PPLACE_EPANG_SPLIT  (nf-core/epang/split)
#      Split the combined alignment into reference and query
#      partitions for EPA-NG placement.
# ------------------------------------------------------------------
[[rules]]
name = "pplace_epang_split"
description = "Split reference+query alignment for EPA-NG (PPLACE)"
when = "config.pplace_tree != \"\""
input = ["intermediates/pplace/ASV.aln.fa.gz", "{config.pplace_tree}"]
output = [
    "intermediates/pplace/split.query.fasta.gz",
    "intermediates/pplace/split.reference.fasta.gz",
]
shell = '''
mkdir -p work/pplace_epang_split intermediates/pplace
cp {input[0]} work/pplace_epang_split/fullaln.fa.gz
cp {input[1]} work/pplace_epang_split/refphylogeny.tree
cd work/pplace_epang_split
gzip -cd fullaln.fa.gz > fullaln.fa
epa-ng --split fullaln.fa refphylogeny.tree
gzip -c query.fasta > query.fasta.gz && rm query.fasta
gzip -c reference.fasta > reference.fasta.gz && rm reference.fasta
cp query.fasta.gz "$OLDPWD/intermediates/pplace/split.query.fasta.gz"
cp reference.fasta.gz "$OLDPWD/intermediates/pplace/split.reference.fasta.gz"
'''
tags = ["pplace", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/epa-ng:0.3.8--h9a82719_1"

[rules.resources]
threads = 2
memory = "4G"

# ------------------------------------------------------------------
# R57  PPLACE_EPANG_PLACE  (nf-core/epang/place)
#      Place the query sequences onto the reference phylogeny with
#      EPA-NG. --model is only passed when pplace_model is non-empty
#      (upstream emits "${meta.model}" which is null for absent).
# ------------------------------------------------------------------
[[rules]]
name = "pplace_epang_place"
description = "Phylogenetic placement of ASVs with EPA-NG (PPLACE)"
when = "config.pplace_tree != \"\""
input = [
    "intermediates/pplace/split.query.fasta.gz",
    "intermediates/pplace/split.reference.fasta.gz",
    "{config.pplace_tree}",
]
output = [
    "intermediates/pplace/ASV.epa_result.jplace.gz",
    "intermediates/pplace/epa_info.log",
]
shell = '''
mkdir -p work/pplace_epang_place intermediates/pplace
cp {input[0]} work/pplace_epang_place/query.fasta.gz
cp {input[1]} work/pplace_epang_place/reference.fasta.gz
cp {input[2]} work/pplace_epang_place/referencetree.tree
cd work/pplace_epang_place
gzip -cd query.fasta.gz > query.fasta
gzip -cd reference.fasta.gz > reference.fasta
MODEL="{config.pplace_model}"
epa-ng --threads {threads} ${MODEL:+--model $MODEL} --ref-msa reference.fasta --tree referencetree.tree --query query.fasta
if [ -e epa_result.jplace ]; then gzip epa_result.jplace; fi
if [ -e epa_result.jplace.gz ]; then cp epa_result.jplace.gz "$OLDPWD/intermediates/pplace/ASV.epa_result.jplace.gz"; fi
if [ -e epa_info.log ]; then cp epa_info.log "$OLDPWD/intermediates/pplace/epa_info.log"; fi
'''
tags = ["pplace", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/epa-ng:0.3.8--h9a82719_1"

[rules.resources]
threads = 2
memory = "4G"

# ------------------------------------------------------------------
# R58  PPLACE_GAPPA_GRAFT  (nf-core/gappa/examinegraft)
#      Graft the EPA-NG placements onto the reference phylogeny.
# ------------------------------------------------------------------
[[rules]]
name = "pplace_gappa_graft"
description = "Graft placements onto the reference phylogeny with gappa (PPLACE)"
when = "config.pplace_tree != \"\""
input = ["intermediates/pplace/ASV.epa_result.jplace.gz"]
output = [
    "intermediates/pplace/grafted.newick",
]
shell = '''
mkdir -p work/pplace_gappa_graft intermediates/pplace
cp {input[0]} work/pplace_gappa_graft/ASV.jplace.gz
cd work/pplace_gappa_graft
gappa examine graft --threads {threads} --file-prefix grafted. --jplace-path ASV.jplace.gz
cp grafted.newick "$OLDPWD/intermediates/pplace/grafted.newick"
'''
tags = ["pplace", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/gappa:0.8.0--h9a82719_0"

[rules.resources]
threads = 2
memory = "4G"

# ------------------------------------------------------------------
# R59  PPLACE_GAPPA_ASSIGN  (nf-core/gappa/examineassign)
#      Assign taxonomy from the placements against the optional
#      reference taxonomy (pplace_taxonomy). Gated on the key —
#      upstream ext.when = { taxonomy }.
# ------------------------------------------------------------------
[[rules]]
name = "pplace_gappa_assign"
description = "Assign taxonomy from placements with gappa (PPLACE, requires pplace_taxonomy)"
when = "config.pplace_tree != \"\" && config.pplace_taxonomy != \"\""
input = [
    "intermediates/pplace/ASV.epa_result.jplace.gz",
    "{config.pplace_taxonomy}",
]
output = [
    "intermediates/pplace/assign.taxonomy.profile.tsv",
    "intermediates/pplace/assign.taxonomy.labelled_tree.newick",
    "intermediates/pplace/assign.taxonomy.per_query.tsv",
    "intermediates/pplace/assign.taxonomy.krona.profile",
    "intermediates/pplace/assign.taxonomy.sativa.tsv",
]
shell = '''
mkdir -p work/pplace_gappa_assign intermediates/pplace
cp {input[0]} work/pplace_gappa_assign/ASV.jplace.gz
cp {input[1]} work/pplace_gappa_assign/taxonomy.tsv
cd work/pplace_gappa_assign
gappa examine assign --threads {threads} --jplace-path ASV.jplace.gz --taxon-file taxonomy.tsv --file-prefix assign. --per-query-results --krona --sativa
cp assign.taxonomy.profile.tsv assign.taxonomy.labelled_tree.newick assign.taxonomy.per_query.tsv assign.taxonomy.krona.profile assign.taxonomy.sativa.tsv "$OLDPWD/intermediates/pplace/"
'''
tags = ["pplace", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/gappa:0.8.0--h9a82719_0"

[rules.resources]
threads = 2
memory = "4G"

# ------------------------------------------------------------------
# R60  PPLACE_GAPPA_HEATTREE  (nf-core/gappa/examineheattree)
#      Per-branch placement-abundance heat tree.
# ------------------------------------------------------------------
[[rules]]
name = "pplace_gappa_heattree"
description = "Heat tree of placement abundances with gappa (PPLACE)"
when = "config.pplace_tree != \"\""
input = ["intermediates/pplace/ASV.epa_result.jplace.gz"]
output = [
    "intermediates/pplace/heattree.newick",
    "intermediates/pplace/heattree.colours.txt",
]
shell = '''
mkdir -p work/pplace_gappa_heattree intermediates/pplace
cp {input[0]} work/pplace_gappa_heattree/ASV.jplace.gz
cd work/pplace_gappa_heattree
gappa examine heat-tree --threads {threads} --file-prefix heattree. --jplace-path ASV.jplace.gz --write-nexus-tree --write-phyloxml-tree --write-svg-tree --log-file heattree.log
grep '^ *At' heattree.log > heattree.colours.txt
cp heattree.newick heattree.colours.txt "$OLDPWD/intermediates/pplace/"
'''
tags = ["pplace", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/gappa:0.8.0--h9a82719_0"

[rules.resources]
threads = 2
memory = "4G"

# ------------------------------------------------------------------
# R61  PPLACE_FORMAT_TAX  (modules/local/format_pplacetax.nf)
#      Pick the best placement per ASV from the gappa per-query
#      taxonomy profile (R, extracted to scripts/format_pplacetax.R).
# ------------------------------------------------------------------
[[rules]]
name = "pplace_format_tax"
description = "Format gappa per-query placements into a taxonomy table (PPLACE)"
when = "config.pplace_tree != \"\" && config.pplace_taxonomy != \"\""
input = ["intermediates/pplace/assign.taxonomy.per_query.tsv"]
output = [
    "intermediates/pplace/pplace_taxonomy.per_query_unique.tsv",
    "results/pplace/{config.pplace_name}.taxonomy.tsv",
]
shell = '''
mkdir -p work/pplace_format_tax results/pplace
cp {input[0]} work/pplace_format_tax/tax.tsv
cd work/pplace_format_tax
NAME="{config.pplace_name}"
Rscript ../../scripts/format_pplacetax.R ${NAME:-user_tree} tax.tsv
cp ${NAME:-user_tree}.taxonomy.per_query_unique.tsv "$OLDPWD/intermediates/pplace/pplace_taxonomy.per_query_unique.tsv"
cp ${NAME:-user_tree}.taxonomy.tsv "$OLDPWD/results/pplace/{config.pplace_name}.taxonomy.tsv"
'''
tags = ["pplace", "taxonomy"]

[rules.environment]
conda = "envs/pplacetax.yaml"

[rules.resources]
threads = 2
memory = "6G"

# ------------------------------------------------------------------
# R62  PPLACE_REFORMAT_TAX  (modules/local/phyloseq_intax.nf)
#      Reformat the PPLACE taxonomy table for phyloseq
#      (scripts/reformat_tax_for_phyloseq.py).
# ------------------------------------------------------------------
[[rules]]
name = "pplace_reformat_tax"
description = "Reformat the PPLACE taxonomy for phyloseq (PPLACE)"
when = "config.pplace_tree != \"\" && config.pplace_taxonomy != \"\""
input = ["results/pplace/{config.pplace_name}.taxonomy.tsv"]
output = ["results/pplace/reformat_{config.pplace_name}.taxonomy.tsv"]
shell = '''
mkdir -p work/pplace_reformat_tax
cp {input[0]} work/pplace_reformat_tax/tax.tsv
cd work/pplace_reformat_tax
python3 ../../scripts/reformat_tax_for_phyloseq.py tax.tsv reformat_tax.tsv
cp reformat_tax.tsv "$OLDPWD/results/pplace/reformat_{config.pplace_name}.taxonomy.tsv"
'''
tags = ["pplace", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/pandas:1.1.5"

[rules.resources]
threads = 1
memory = "1G"

# ------------------------------------------------------------------
# R63  KRAKEN2_DB_PREP  (upstream kraken2_taxonomy_wf db-branch)
#      Validate + prepare the user kraken2 database: a .tar.gz/.tgz
#      bundle is unpacked (upstream UNTAR), a directory is used as-is,
#      anything else errors (upstream fails the channel with
#      "neither a directory nor a file that ends in '.tar.gz'").
# ------------------------------------------------------------------
[[rules]]
name = "kraken2_db_prep"
description = "Prepare the kraken2 database (untar bundles, validate directories)"
when = "config.kraken2_ref_tax_custom != \"\""
input = ["{config.kraken2_ref_tax_custom}"]
output = ["intermediates/kraken2/db.ready"]
shell = '''
mkdir -p work/kraken2_db_prep intermediates/kraken2
DB="{config.kraken2_ref_tax_custom}"
if [ -d "$DB" ]; then
    cp -r "$DB"/. ./db/
    DB="$PWD/db"
elif [[ "$DB" == *.tar.gz || "$DB" == *.tgz ]]; then
    tar xzf "$DB"
    DB=$(basename "$DB" .tar.gz); DB=${DB%.tgz}
    mkdir -p "$DB"
    mv *.k2d "$DB" 2>/dev/null || echo "nothing to do"
    DB="$PWD/$DB"
else
    echo "kraken2_ref_tax_custom is neither a directory nor a file that ends in '.tar.gz' or '.tgz'" >&2
    exit 1
fi
echo "$DB" > db.ready
cp db.ready "$OLDPWD/intermediates/kraken2/db.ready"
'''
tags = ["kraken2", "taxonomy"]

[rules.environment]
# Upstream untar env (coreutils/grep/gzip/lbzip2/sed/tar) — wave container
# built from that env, matching the port's container-pinning convention
# (quay mulled hash for this env is not verifiable).
singularity = "docker://community.wave.seqera.io/library/coreutils_grep_gzip_lbzip2_pruned:838ba80435a629f8"

[rules.resources]
threads = 1
memory = "2G"

# ------------------------------------------------------------------
# R64  KRAKEN2_CLASSIFY  (nf-core/kraken2/kraken2)
#      Classify the ASV sequences against the kraken2 database.
#      save_reads_assignment = true (upstream kraken2_taxonomy_wf).
# ------------------------------------------------------------------
[[rules]]
name = "kraken2_classify"
description = "Classify ASVs with kraken2 (alternative taxonomy branch)"
when = "config.kraken2_ref_tax_custom != \"\""
input = [
    "results/dada2/ASV_seqs.fasta",
    "intermediates/kraken2/db.ready",
]
output = [
    "intermediates/kraken2/ASV_tax.kraken2.kraken2.report.txt",
    "intermediates/kraken2/ASV_tax.kraken2.classifiedreads.txt",
]
shell = '''
mkdir -p work/kraken2_classify intermediates/kraken2
cp {input[0]} work/kraken2_classify/ASV_tax.fasta
cd work/kraken2_classify
DB=$(cat ../../intermediates/kraken2/db.ready)
kraken2 --db "$DB" --threads {threads} --report ASV_tax.kraken2.report.txt --output ASV_tax.kraken2.classifiedreads.txt --use-names --confidence {config.kraken2_confidence} ASV_tax.fasta
cp ASV_tax.kraken2.report.txt "$OLDPWD/intermediates/kraken2/ASV_tax.kraken2.kraken2.report.txt"
cp ASV_tax.kraken2.classifiedreads.txt "$OLDPWD/intermediates/kraken2/ASV_tax.kraken2.classifiedreads.txt"
'''
tags = ["kraken2", "taxonomy"]

[rules.environment]
singularity = "docker://community.wave.seqera.io/library/kraken2_coreutils_pigz:920ecc6b96e2ba71"

[rules.resources]
threads = 4
memory = "8G"

# ------------------------------------------------------------------
# R65  KRAKEN2_FORMAT_TAXRESULTS  (modules/local/format_taxresults_kraken2.nf)
#      Convert the kraken2 report + read-classification into per-ASV
#      taxonomy tables (R, extracted to scripts/format_taxresults_kraken2.R).
# ------------------------------------------------------------------
[[rules]]
name = "kraken2_format_taxresults"
description = "Format kraken2 report+classification into per-ASV taxonomy tables"
when = "config.kraken2_ref_tax_custom != \"\""
input = [
    "intermediates/kraken2/ASV_tax.kraken2.kraken2.report.txt",
    "intermediates/kraken2/ASV_tax.kraken2.classifiedreads.txt",
]
output = [
    "intermediates/kraken2/ASV_tax.kraken2.keys.tsv",
    "intermediates/kraken2/ASV_tax.kraken2.complete.tsv",
    "results/kraken2/ASV_tax.kraken2.tsv",
    "results/kraken2/ASV_tax.kraken2.into-qiime2.tsv",
]
shell = '''
mkdir -p work/kraken2_format_taxresults results/kraken2
cp {input[0]} work/kraken2_format_taxresults/report.txt
cp {input[1]} work/kraken2_format_taxresults/classifiedreads.txt
cd work/kraken2_format_taxresults
LEVELS="{config.kraken2_assign_taxlevels}"
Rscript ../../scripts/format_taxresults_kraken2.R report.txt classifiedreads.txt ${LEVELS:-"D,P,C,O,F,G,S"}
cp ASV_tax.kraken2.keys.tsv "$OLDPWD/intermediates/kraken2/ASV_tax.kraken2.keys.tsv"
cp ASV_tax.kraken2.complete.tsv "$OLDPWD/intermediates/kraken2/ASV_tax.kraken2.complete.tsv"
cp ASV_tax.kraken2.tsv "$OLDPWD/results/kraken2/ASV_tax.kraken2.tsv"
cp ASV_tax.kraken2.into-qiime2.tsv "$OLDPWD/results/kraken2/ASV_tax.kraken2.into-qiime2.tsv"
'''
tags = ["kraken2", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/r-base:4.2.1"

[rules.resources]
threads = 2
memory = "3G"

# ------------------------------------------------------------------
# R66  SINTAX_FORMAT_DB  (modules/local/format_taxonomy_sintax.nf,
#      custom-reference branch)
#      Validate + gzip the user SINTAX reference (idempotent: a file
#      with the gzip magic bytes is copied as-is) and emit the
#      reference-taxonomy info file. Named pre-built SINTAX databases
#      (params.sintax_ref_databases) are excluded — see README.
# ------------------------------------------------------------------
[[rules]]
name = "sintax_format_db"
description = "Prepare the user SINTAX reference database (gzip-validate + info file)"
when = "config.sintax_ref_tax_custom != \"\""
input = ["{config.sintax_ref_tax_custom}"]
output = [
    "intermediates/sintax/sintaxdb.fa.gz",
    "intermediates/sintax/ref_taxonomy_sintax.txt",
]
shell = '''
mkdir -p work/sintax_format_db intermediates/sintax
cp {input[0]} work/sintax_format_db/database
cd work/sintax_format_db
set -- $(head -c2 database | od -An -t u1)
if [ "$#" -ge 2 ] && [ "$1" = "31" ] && [ "$2" = "139" ]; then
    cp -fL database sintaxdb.fa.gz
else
    gzip -c database > sintaxdb.fa.gz
fi
printf '%s\n' \
    "--sintax_ref_tax_custom: {config.sintax_ref_tax_custom}" \
    "Title: User-supplied SINTAX reference" \
    "Citation: Not specified" \
    "dbversion label: user_supplied" > ref_taxonomy_sintax.txt
cp sintaxdb.fa.gz ref_taxonomy_sintax.txt "$OLDPWD/intermediates/sintax/"
'''
tags = ["sintax", "taxonomy"]

[rules.environment]
singularity = "docker://docker.io/biocontainers/biocontainers:v1.2.0_cv1"

[rules.resources]
threads = 1
memory = "2G"

# ------------------------------------------------------------------
# R67  SINTAX_CLASSIFY  (nf-core/vsearch/sintax)
#      SINTAX taxonomy assignment of the ASVs with vsearch.
# ------------------------------------------------------------------
[[rules]]
name = "sintax_classify"
description = "SINTAX taxonomy assignment with vsearch (alternative taxonomy branch)"
when = "config.sintax_ref_tax_custom != \"\""
input = [
    "results/dada2/ASV_seqs.fasta",
    "intermediates/sintax/sintaxdb.fa.gz",
]
output = ["intermediates/sintax/ASV_tax.sintax.tsv"]
shell = '''
mkdir -p work/sintax_classify intermediates/sintax
cp {input[0]} work/sintax_classify/ASV_tax.fasta
cp {input[1]} work/sintax_classify/sintaxdb.fa.gz
cd work/sintax_classify
vsearch --sintax ASV_tax.fasta --db sintaxdb.fa.gz --threads {threads} --gzip_decompress --sintax_cutoff 0.8 --randseed {config.seed} --tabbedout ASV_tax.sintax.tsv
cp ASV_tax.sintax.tsv "$OLDPWD/intermediates/sintax/ASV_tax.sintax.tsv"
'''
tags = ["sintax", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/vsearch:2.31.0--hd2be7a0_0"

[rules.resources]
threads = 1
memory = "4G"

# ------------------------------------------------------------------
# R68  SINTAX_FORMAT_TAX  (modules/local/format_taxonomy_sintax.nf
#      consumer side: bin/convert_sintax_output.py)
#      Convert the vsearch SINTAX tabbed output into a per-ASV
#      taxonomy table (phases missing ranks with empty columns).
