tags = ["qiime2", "export"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

# QIIME2_ANCOM (ANCOM_ASV + ANCOM_TAX): samples without a metadata
# value for the category are filtered out first (FILTERSAMPLES), then
# ANCOM runs at ASV level and per tax level; levels collapsing to
# < 2 taxa write a WARNING file instead (upstream error_ignore).
[[rules]]
name = "qiime2_ancom"
description = "QIIME2 ANCOM differential abundance at ASV and tax levels"
when = "config.run_qiime2 && !config.skip_qiime_downstream && !config.skip_taxonomy && config.ancom"
input = [
    "{config.metadata_file}",
    "intermediates/qiime2/table.qza",
    "intermediates/qiime2/taxonomy.qza",
    "intermediates/qiime2/categories_all.txt",
]
output = [
    "results/qiime2/ancom/Category-group-ASV/index.html",
    "results/qiime2/ancom/Category-group-level-2/index.html",
    "results/qiime2/ancom/Category-group-level-3/index.html",
    "results/qiime2/ancom/Category-group-level-4/index.html",
    "results/qiime2/ancom/Category-group-level-5/index.html",
    "results/qiime2/ancom/Category-group-level-6/index.html",
]
shell = '''
export XDG_CONFIG_HOME="work/qiime2_ancom/xdgconfig"
export MPLCONFIGDIR="work/qiime2_ancom/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_ancom/numbacache"
mkdir -p results/qiime2/ancom
CATS=$(cat {input[3]})
if [ -z "$CATS" ]; then
    echo "WARNING: no suitable metadata category found for ANCOM" >&2
    exit 0
fi
for cat in $(echo "$CATS" | tr ',' ' '); do
    qiime feature-table filter-samples --i-table {input[1]} --m-metadata-file {input[0]} --p-where "${cat}<>''" --o-filtered-table work/qiime2_ancom/${cat}.qza
    qiime composition add-pseudocount --i-table work/qiime2_ancom/${cat}.qza --o-composition-table work/qiime2_ancom/comp-${cat}.qza
    qiime composition ancom --i-table work/qiime2_ancom/comp-${cat}.qza --m-metadata-file {input[0]} --m-metadata-column $cat --o-visualization work/qiime2_ancom/comp-${cat}.qzv
    qiime tools export --input-path work/qiime2_ancom/comp-${cat}.qzv --output-path results/qiime2/ancom/Category-${cat}-ASV
    for lvl in $(seq {config.tax_agglom_min} 1 {config.tax_agglom_max}); do
        qiime taxa collapse --i-table work/qiime2_ancom/${cat}.qza --i-taxonomy {input[2]} --p-level $lvl --o-collapsed-table work/qiime2_ancom/lvl${lvl}-${cat}.qza
        qiime tools export --input-path work/qiime2_ancom/lvl${lvl}-${cat}.qza --output-path work/qiime2_ancom/exported
        biom convert -i work/qiime2_ancom/exported/feature-table.biom -o work/qiime2_ancom/${cat}-level-${lvl}.feature-table.tsv --to-tsv
        rm -rf work/qiime2_ancom/exported
        if [ $(grep -v '^#' -c work/qiime2_ancom/${cat}-level-${lvl}.feature-table.tsv) -lt 2 ]; then
            echo "Summing your data at taxonomic level $lvl produced less than two rows (taxa), ANCOM can't proceed -- did you specify a bad reference taxonomy?" > results/qiime2/ancom/Category-${cat}-level-${lvl}.WARNING.txt
        else
            qiime composition add-pseudocount --i-table work/qiime2_ancom/lvl${lvl}-${cat}.qza --o-composition-table work/qiime2_ancom/comp-lvl${lvl}-${cat}.qza
            qiime composition ancom --i-table work/qiime2_ancom/comp-lvl${lvl}-${cat}.qza --m-metadata-file {input[0]} --m-metadata-column $cat --o-visualization work/qiime2_ancom/comp-lvl${lvl}-${cat}.qzv
            qiime tools export --input-path work/qiime2_ancom/comp-lvl${lvl}-${cat}.qzv --output-path results/qiime2/ancom/Category-${cat}-level-${lvl}
        fi
    done
done
'''
tags = ["qiime2", "differential-abundance"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"
time_limit = "24h"

# QIIME2_ANCOMBC (ANCOMBC_ASV + ANCOMBC_TAX, incl. the
# ancombc_formula variants which run on the unfiltered table):
# ancombc + tabulate + da-barplot per category/formula and tax level.
[[rules]]
name = "qiime2_ancombc"
description = "QIIME2 ANCOM-BC differential abundance at ASV and tax levels"
when = "config.run_qiime2 && !config.skip_qiime_downstream && !config.skip_taxonomy && (config.ancombc || config.ancombc_formula != \"\")"
input = [
    "{config.metadata_file}",
    "intermediates/qiime2/table.qza",
    "intermediates/qiime2/taxonomy.qza",
    "intermediates/qiime2/categories_all.txt",
]
output = [
    "results/qiime2/ancombc/differentials/Category-group-ASV/index.html",
    "results/qiime2/ancombc/da_barplot/Category-group-ASV/index.html",
    "results/qiime2/ancombc/differentials/Category-group-level-2/index.html",
    "results/qiime2/ancombc/differentials/Category-group-level-3/index.html",
    "results/qiime2/ancombc/differentials/Category-group-level-4/index.html",
    "results/qiime2/ancombc/differentials/Category-group-level-5/index.html",
    "results/qiime2/ancombc/differentials/Category-group-level-6/index.html",
    "results/qiime2/ancombc/da_barplot/Category-group-level-2/index.html",
    "results/qiime2/ancombc/da_barplot/Category-group-level-3/index.html",
    "results/qiime2/ancombc/da_barplot/Category-group-level-4/index.html",
    "results/qiime2/ancombc/da_barplot/Category-group-level-5/index.html",
    "results/qiime2/ancombc/da_barplot/Category-group-level-6/index.html",
]
shell = '''
export XDG_CONFIG_HOME="work/qiime2_ancombc/xdgconfig"
export MPLCONFIGDIR="work/qiime2_ancombc/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_ancombc/numbacache"
mkdir -p results/qiime2/ancombc
# formula variants run on the unfiltered table (upstream ANCOMBC_FORMULA_*)
if [ -n "{config.ancombc_formula}" ]; then FORMULAS=$(echo {config.ancombc_formula} | tr ',' ' '); UNFILTERED=1; else FORMULAS=$(cat {input[3]}); UNFILTERED=0; fi
if [ -z "$FORMULAS" ]; then
    echo "WARNING: no suitable metadata category/formula found for ANCOM-BC" >&2
    exit 0
fi
for formula in $FORMULAS; do
    if [ "$UNFILTERED" = "1" ]; then TBL={input[1]}; else
        qiime feature-table filter-samples --i-table {input[1]} --m-metadata-file {input[0]} --p-where "${formula}<>''" --o-filtered-table work/qiime2_ancombc/${formula}.qza
        TBL=work/qiime2_ancombc/${formula}.qza
    fi
    qiime composition ancombc --i-table "$TBL" --m-metadata-file {input[0]} --p-prv-cut 0.1 --p-lib-cut 500 --p-alpha 0.05 --p-conserve --p-formula "$formula" --o-differentials work/qiime2_ancombc/${formula}.differentials.qza --verbose
    qiime tools export --input-path work/qiime2_ancombc/${formula}.differentials.qza --output-path results/qiime2/ancombc/differentials/Category-${formula}-ASV
    qiime composition tabulate --i-data work/qiime2_ancombc/${formula}.differentials.qza --o-visualization work/qiime2_ancombc/${formula}.differentials.qzv
    qiime tools export --input-path work/qiime2_ancombc/${formula}.differentials.qzv --output-path results/qiime2/ancombc/differentials/Category-${formula}-ASV
    qiime composition da-barplot --i-data work/qiime2_ancombc/${formula}.differentials.qza --p-effect-size-threshold {config.ancombc_effect_size} --p-significance-threshold {config.ancombc_significance} --p-label-limit 1000 --o-visualization work/qiime2_ancombc/${formula}.da_barplot.qzv
    qiime tools export --input-path work/qiime2_ancombc/${formula}.da_barplot.qzv --output-path results/qiime2/ancombc/da_barplot/Category-${formula}-ASV
    for lvl in $(seq {config.tax_agglom_min} 1 {config.tax_agglom_max}); do
        qiime taxa collapse --i-table "$TBL" --i-taxonomy {input[2]} --p-level $lvl --o-collapsed-table work/qiime2_ancombc/lvl${lvl}-${formula}.qza
        qiime tools export --input-path work/qiime2_ancombc/lvl${lvl}-${formula}.qza --output-path work/qiime2_ancombc/exported
        biom convert -i work/qiime2_ancombc/exported/feature-table.biom -o work/qiime2_ancombc/lvl${lvl}-${formula}.feature-table.tsv --to-tsv
        rm -rf work/qiime2_ancombc/exported
        if [ $(grep -v '^#' -c work/qiime2_ancombc/lvl${lvl}-${formula}.feature-table.tsv) -lt 2 ]; then
            echo "Summing your data at taxonomic level $lvl produced less than two rows (taxa), ANCOMBC can't proceed -- did you specify a bad reference taxonomy?" > results/qiime2/ancombc/differentials/Category-${formula}-level-${lvl}.WARNING.txt
            echo "Summing your data at taxonomic level $lvl produced less than two rows (taxa), ANCOMBC can't proceed -- did you specify a bad reference taxonomy?" > results/qiime2/ancombc/da_barplot/Category-${formula}-level-${lvl}.WARNING.txt
        else
            qiime composition ancombc --i-table work/qiime2_ancombc/lvl${lvl}-${formula}.qza --m-metadata-file {input[0]} --p-prv-cut 0.1 --p-lib-cut 500 --p-alpha 0.05 --p-conserve --p-formula "$formula" --o-differentials work/qiime2_ancombc/lvl${lvl}-${formula}.differentials.qza --verbose
            qiime tools export --input-path work/qiime2_ancombc/lvl${lvl}-${formula}.differentials.qza --output-path results/qiime2/ancombc/differentials/Category-${formula}-level-${lvl}
            qiime composition tabulate --i-data work/qiime2_ancombc/lvl${lvl}-${formula}.differentials.qza --o-visualization work/qiime2_ancombc/lvl${lvl}-${formula}.differentials.qzv
            qiime tools export --input-path work/qiime2_ancombc/lvl${lvl}-${formula}.differentials.qzv --output-path results/qiime2/ancombc/differentials/Category-${formula}-level-${lvl}
            qiime composition da-barplot --i-data work/qiime2_ancombc/lvl${lvl}-${formula}.differentials.qza --p-effect-size-threshold {config.ancombc_effect_size} --p-significance-threshold {config.ancombc_significance} --p-label-limit 1000 --o-visualization work/qiime2_ancombc/lvl${lvl}-${formula}.da_barplot.qzv
            qiime tools export --input-path work/qiime2_ancombc/lvl${lvl}-${formula}.da_barplot.qzv --output-path results/qiime2/ancombc/da_barplot/Category-${formula}-level-${lvl}
        fi
    done
done
'''
tags = ["qiime2", "differential-abundance"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"
time_limit = "24h"

# QIIME2_ANCOMBC2 (ANCOMBC2_ASV + ANCOMBC2_TAX, incl. the
# ancombc2_formula variants): ancombc2 + tabulate + visualizer +
# volcano plot per category/formula and tax level.
[[rules]]
name = "qiime2_ancombc2"
description = "QIIME2 ANCOM-BC2 differential abundance at ASV and tax levels"
when = "config.run_qiime2 && !config.skip_qiime_downstream && !config.skip_taxonomy && (config.ancombc2 || config.ancombc2_formula != \"\")"
input = [
    "{config.metadata_file}",
    "intermediates/qiime2/table.qza",
    "intermediates/qiime2/taxonomy.qza",
    "intermediates/qiime2/categories_all.txt",
]
output = [
    "results/qiime2/ancombc2/Category-group-ASV/differentials/index.html",
    "results/qiime2/ancombc2/Category-group-ASV/ASV-group.visualizer.qzv",
    "results/qiime2/ancombc2/Category-group-ASV/ASV-group.volcano_plot.svg",
    "results/qiime2/ancombc2/Category-group-level-2/differentials/index.html",
    "results/qiime2/ancombc2/Category-group-level-3/differentials/index.html",
    "results/qiime2/ancombc2/Category-group-level-4/differentials/index.html",
    "results/qiime2/ancombc2/Category-group-level-5/differentials/index.html",
    "results/qiime2/ancombc2/Category-group-level-6/differentials/index.html",
]
shell = '''
export XDG_CONFIG_HOME="work/qiime2_ancombc2/xdgconfig"
export MPLCONFIGDIR="work/qiime2_ancombc2/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_ancombc2/numbacache"
mkdir -p results/qiime2/ancombc2
if [ -n "{config.ancombc2_formula}" ]; then FORMULAS=$(echo {config.ancombc2_formula} | tr ',' ' '); UNFILTERED=1; else FORMULAS=$(cat {input[3]}); UNFILTERED=0; fi
if [ -z "$FORMULAS" ]; then
    echo "WARNING: no suitable metadata category/formula found for ANCOM-BC2" >&2
    exit 0
fi
for formula in $FORMULAS; do
    if [ "$UNFILTERED" = "1" ]; then TBL={input[1]}; else
        qiime feature-table filter-samples --i-table {input[1]} --m-metadata-file {input[0]} --p-where "${formula}<>''" --o-filtered-table work/qiime2_ancombc2/${formula}.qza
        TBL=work/qiime2_ancombc2/${formula}.qza
    fi
    # ASV-level
    qiime composition ancombc2 --i-table "$TBL" --m-metadata-file {input[0]} --p-p-adjust-method "holm" --p-prevalence-cutoff 0.1 --p-alpha 0.05 --p-fixed-effects-formula "$formula" --o-ancombc2-output work/qiime2_ancombc2/ASV-${formula}.differentials.qza --p-num-processes {threads} --verbose
    qiime tools export --input-path work/qiime2_ancombc2/ASV-${formula}.differentials.qza --output-path results/qiime2/ancombc2/Category-${formula}-ASV/differentials
    qiime composition tabulate --i-data work/qiime2_ancombc2/ASV-${formula}.differentials.qza --o-visualization work/qiime2_ancombc2/ASV-${formula}.differentials.qzv
    qiime tools export --input-path work/qiime2_ancombc2/ASV-${formula}.differentials.qzv --output-path results/qiime2/ancombc2/Category-${formula}-ASV/differentials
    qiime composition ancombc2-visualizer --i-data work/qiime2_ancombc2/ASV-${formula}.differentials.qza --o-visualization work/qiime2_ancombc2/ASV-${formula}.visualizer.qzv
    # 'qiime tools export' does not produce a valid html
    mv work/qiime2_ancombc2/ASV-${formula}.visualizer.qzv results/qiime2/ancombc2/Category-${formula}-ASV/ASV-${formula}.visualizer.qzv
    # volcano plot
    cd results/qiime2/ancombc2/Category-${formula}-ASV
    Rscript ../../../../scripts/ancombc_volcanoplot.r differentials/lfc.jsonl differentials/q.jsonl 0.05 1 0 differentials/p.jsonl differentials/se.jsonl differentials/passed_ss.jsonl "ASV-"
    cd "$OLDPWD"
    for lvl in $(seq {config.tax_agglom_min} 1 {config.tax_agglom_max}); do
        qiime taxa collapse --i-table "$TBL" --i-taxonomy {input[2]} --p-level $lvl --o-collapsed-table work/qiime2_ancombc2/lvl${lvl}-${formula}.qza
        qiime tools export --input-path work/qiime2_ancombc2/lvl${lvl}-${formula}.qza --output-path work/qiime2_ancombc2/exported
        biom convert -i work/qiime2_ancombc2/exported/feature-table.biom -o work/qiime2_ancombc2/lvl${lvl}-${formula}.feature-table.tsv --to-tsv
        rm -rf work/qiime2_ancombc2/exported
        if [ $(grep -v '^#' -c work/qiime2_ancombc2/lvl${lvl}-${formula}.feature-table.tsv) -lt 2 ]; then
            mkdir -p results/qiime2/ancombc2/Category-${formula}-level-${lvl}/differentials
            echo "Summing your data at taxonomic level $lvl produced less than two rows (taxa), ANCOMBC2 can't proceed -- did you specify a bad reference taxonomy?" > results/qiime2/ancombc2/Category-${formula}-level-${lvl}/differentials/WARNING.txt
        else
            qiime composition ancombc2 --i-table work/qiime2_ancombc2/lvl${lvl}-${formula}.qza --m-metadata-file {input[0]} --p-p-adjust-method "holm" --p-prevalence-cutoff 0.1 --p-alpha 0.05 --p-fixed-effects-formula "$formula" --o-ancombc2-output work/qiime2_ancombc2/lvl${lvl}-${formula}.differentials.qza --p-num-processes {threads} --verbose
            qiime tools export --input-path work/qiime2_ancombc2/lvl${lvl}-${formula}.differentials.qza --output-path results/qiime2/ancombc2/Category-${formula}-level-${lvl}/differentials
            qiime composition tabulate --i-data work/qiime2_ancombc2/lvl${lvl}-${formula}.differentials.qza --o-visualization work/qiime2_ancombc2/lvl${lvl}-${formula}.differentials.qzv
            qiime tools export --input-path work/qiime2_ancombc2/lvl${lvl}-${formula}.differentials.qzv --output-path results/qiime2/ancombc2/Category-${formula}-level-${lvl}/differentials
            qiime composition ancombc2-visualizer --i-data work/qiime2_ancombc2/lvl${lvl}-${formula}.differentials.qza --o-visualization work/qiime2_ancombc2/lvl${lvl}-${formula}.visualizer.qzv
            mv work/qiime2_ancombc2/lvl${lvl}-${formula}.visualizer.qzv results/qiime2/ancombc2/Category-${formula}-level-${lvl}/lvl${lvl}-${formula}.visualizer.qzv
            cd results/qiime2/ancombc2/Category-${formula}-level-${lvl}
            Rscript ../../../../scripts/ancombc_volcanoplot.r differentials/lfc.jsonl differentials/q.jsonl 0.05 1 0 differentials/p.jsonl differentials/se.jsonl differentials/passed_ss.jsonl "lvl${lvl}-"
            cd "$OLDPWD"
        fi
    done
done
'''
tags = ["qiime2", "differential-abundance"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 6
memory = "6G"
time_limit = "24h"

# QIIME2_PREPTAX (qiime2_preptax.nf + qiime2_extract.nf +
# qiime2_train.nf): download the SILVA qza reference pair, reformat to
# silva.fna/silva.tax (taxref_reformat_qiime_silva138.sh), import,
# extract primer regions with the configured primers and train a
# Naive-Bayes classifier. Requires FW_primer/RV_primer (like
# upstream: extract-reads with empty primers fails in QIIME2).
[[rules]]
name = "qiime2_preptax"
description = "Train a QIIME2 Naive-Bayes classifier from the SILVA reference"
when = "config.run_qiime2 && !config.skip_taxonomy && config.qiime_ref_taxonomy != \"\" && config.classifier == \"\""
input = []
output = ["intermediates/qiime2/classifier.qza"]
shell = '''
export XDG_CONFIG_HOME="work/qiime2_preptax/xdgconfig"
export MPLCONFIGDIR="work/qiime2_preptax/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_preptax/numbacache"
mkdir -p work/qiime2_preptax intermediates/qiime2
cd work/qiime2_preptax
curl -fsSL -o ref_seqs.qza $(echo {config.qiime_ref_taxonomy_urls} | cut -d, -f1)
curl -fsSL -o ref_tax.qza $(echo {config.qiime_ref_taxonomy_urls} | cut -d, -f2)
sh ../../scripts/taxref_reformat_qiime_silva138.sh
qiime tools import --type 'FeatureData[Sequence]' --input-path silva.fna --output-path ref-seq.qza
qiime tools import --type 'FeatureData[Taxonomy]' --input-format HeaderlessTSVTaxonomyFormat --input-path silva.tax --output-path ref-taxonomy.qza
qiime feature-classifier extract-reads --p-n-jobs {threads} --i-sequences ref-seq.qza --p-f-primer {config.FW_primer} --p-r-primer {config.RV_primer} --o-reads ref-seq-extracted.qza --quiet
qiime feature-classifier fit-classifier-naive-bayes --i-reference-reads ref-seq-extracted.qza --i-reference-taxonomy ref-taxonomy.qza --o-classifier "$OLDPWD/intermediates/qiime2/classifier.qza" --quiet
'''
tags = ["qiime2", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 10
memory = "20G"
time_limit = "24h"

# QIIME2_CLASSIFY (qiime2_classify.nf): classify-sklearn with the
# trained classifier (or a user-supplied pre-trained one via
# config.classifier — copied in-shell to the same intermediate path),
# then tabulate + export. The taxonomy.qza lands at the same path the
# qiime2_intax rule writes, so qiime2_barplot / exports consume
# whichever taxonomy was produced (the two rules are mutually
# exclusive via their gates).
[[rules]]
name = "qiime2_classify"
description = "Classify ASVs with a trained QIIME2 classifier"
when = "config.run_qiime2 && !config.skip_taxonomy && (config.qiime_ref_taxonomy != \"\" || config.classifier != \"\") && (config.pplace_tree == \"\" || config.pplace_taxonomy == \"\") && config.skip_dada_taxonomy && config.sintax_ref_tax_custom == \"\" && config.kraken2_ref_tax_custom == \"\" && config.sidle_ref_tax_custom == \"\""
input = ["intermediates/qiime2/rep-seqs.qza", "intermediates/qiime2/classifier.qza"]
output = [
    "intermediates/qiime2/taxonomy.qza",
    "results/qiime2/taxonomy/taxonomy.tsv",
]
shell = '''
export XDG_CONFIG_HOME="work/qiime2_classify/xdgconfig"
export MPLCONFIGDIR="work/qiime2_classify/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_classify/numbacache"
mkdir -p work/qiime2_classify results/qiime2/taxonomy
# user-supplied pre-trained classifier (skips qiime2_preptax training)
if [ -n "{config.classifier}" ] && [ ! -f intermediates/qiime2/classifier.qza ]; then
    cp {config.classifier} intermediates/qiime2/classifier.qza
fi
qiime feature-classifier classify-sklearn --i-classifier intermediates/qiime2/classifier.qza --p-n-jobs {threads} --i-reads {input[0]} --o-classification work/qiime2_classify/taxonomy.qza --verbose
qiime metadata tabulate --m-input-file work/qiime2_classify/taxonomy.qza --o-visualization work/qiime2_classify/taxonomy.qzv --verbose
qiime tools export --input-path work/qiime2_classify/taxonomy.qza --output-path results/qiime2/taxonomy
qiime tools export --input-path work/qiime2_classify/taxonomy.qzv --output-path results/qiime2/taxonomy
cp work/qiime2_classify/taxonomy.qza {output[0]}
'''
tags = ["qiime2", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 10
memory = "20G"
time_limit = "24h"

# ------------------------------------------------------------------
# R48  MULTIQC  (process_single)
#      MultiQC aggregates fastqc zips + cutadapt logs in a scratch
#      dir (multiqc scans its cwd ".")
# ------------------------------------------------------------------
[[rules]]
name = "multiqc"
description = "MultiQC report over FastQC and cutadapt results"
when = "!config.skip_multiqc"
input = ["assets/multiqc_config.yml"]
expand_inputs = [
    { pattern = "results/fastqc/{sample}_1_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "results/fastqc/{sample}_2_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "results/cutadapt/{sample}.trimmed.cutadapt.log", variables = { sample = "config.samples_list" } },
]
output = ["results/multiqc/multiqc_report.html"]
shell = '''
mkdir -p work/multiqc
cp {input} work/multiqc/
cd work/multiqc
multiqc --force --config multiqc_config.yml .
cp multiqc_report.html "$OLDPWD/results/multiqc/multiqc_report.html"
'''
tags = ["reporting"]

[rules.environment]
conda = "envs/multiqc.yaml"

[rules.resources]
threads = 1
memory = "1G"

# ------------------------------------------------------------------
# R49  PICRUST  (process_high + process_medium_memory:
#      10 cpus / 50G / 24h)
#      Functional predictions from the ASV table. Upstream picks a
#      QIIME2-filtered or the raw DADA2 source depending on the run
#      configuration; the port always uses the DADA2 source (the
#      QIIME2 source additionally requires run_qiime2 + abundance
#      tables + a taxonomy — see README deviations). The pipeline
#      writes a fixed "all_output" dir plus flat *_descrip.tsv files
#      in its cwd, so it runs in a scratch dir and the results are
#      copied back. The upstream source-message file (filename == the
#      message text) is written as picrust_message.txt instead.
# ------------------------------------------------------------------
[[rules]]
name = "picrust"
description = "PICRUSt2 functional predictions from the ASV table"
when = "config.picrust"
input = [
    "results/dada2/ASV_seqs.fasta",
    "results/dada2/ASV_table.tsv",
]
output = [
    "results/picrust/EC_pred_metagenome_unstrat_descrip.tsv",
    "results/picrust/KO_pred_metagenome_unstrat_descrip.tsv",
    "results/picrust/METACYC_path_abun_unstrat_descrip.tsv",
    "results/picrust/picrust.args.txt",
    "results/picrust/picrust_message.txt",
]
shell = '''
mkdir -p work/picrust results/picrust
cp {input[0]} work/picrust/ASV_seqs.fasta
cp {input[1]} work/picrust/ASV_table.tsv
cd work/picrust
picrust2_pipeline.py -t epa-ng --remove_intermediate -s ASV_seqs.fasta -i ASV_table.tsv -o all_output -p {threads} --in_traits EC,KO --verbose
add_descriptions.py -i all_output/EC_metagenome_out/pred_metagenome_unstrat.tsv.gz -m EC -o EC_pred_metagenome_unstrat_descrip.tsv
add_descriptions.py -i all_output/KO_metagenome_out/pred_metagenome_unstrat.tsv.gz -m KO -o KO_pred_metagenome_unstrat_descrip.tsv
add_descriptions.py -i all_output/pathways_out/path_abun_unstrat.tsv.gz -m METACYC -o METACYC_path_abun_unstrat_descrip.tsv
echo "This Picrust2 analysis is based on unfiltered reads from DADA2" > picrust_message.txt
echo -e "picrust\\t-t epa-ng --remove_intermediate" > picrust.args.txt
cp EC_pred_metagenome_unstrat_descrip.tsv KO_pred_metagenome_unstrat_descrip.tsv METACYC_path_abun_unstrat_descrip.tsv picrust.args.txt picrust_message.txt "$OLDPWD/results/picrust/"
'''
tags = ["functional-prediction"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/picrust2:2.6.3--pyhdfd78af_0"

[rules.resources]
threads = 10
memory = "50G"
time_limit = "24h"
[[rules]]
name = "sbdiexport"
description = "SBDI submission tables (event/dna/emof/asv-table) from the DADA2 ASV and taxonomy tables"
when = "config.sbdiexport && !config.skip_taxonomy && !config.skip_dada_taxonomy"
input = [
    "results/dada2/ASV_table.tsv",
    "results/dada2/ASV_tax_species.sbdi-gtdb_R11-RS232-1.tsv",
    "{config.metadata_file}",
]
output = [
    "results/SBDI/event.tsv",
    "results/SBDI/dna.tsv",
    "results/SBDI/emof.tsv",
    "results/SBDI/asv-table.tsv",
]
shell = '''
mkdir -p work/sbdiexport results/SBDI
cp {input[0]} work/sbdiexport/ASV_table.tsv
cp {input[1]} work/sbdiexport/ASV_tax_species.tsv
cp {input[2]} work/sbdiexport/metadata.tsv
cd work/sbdiexport
Rscript ../../scripts/sbdiexport.R paired "{config.FW_primer}" "{config.RV_primer}" ASV_table.tsv ASV_tax_species.tsv metadata.tsv
cp event.tsv dna.tsv emof.tsv asv-table.tsv "$OLDPWD/results/SBDI/"
'''
tags = ["export"]

[rules.environment]
conda = "envs/sbdiexport.yaml"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "sbdiexportreannotate"
description = "SBDI annotation.tsv re-annotating the exported ASV taxonomy"
when = "config.sbdiexport && !config.skip_taxonomy && !config.skip_dada_taxonomy"
input = [
    "results/dada2/ASV_tax_species.sbdi-gtdb_R11-RS232-1.tsv",
]
output = [
    "results/SBDI/annotation.tsv",
]
shell = '''
mkdir -p work/sbdiexportreannotate results/SBDI
cp {input[0]} work/sbdiexportreannotate/ASV_tax_species.tsv
cd work/sbdiexportreannotate
Rscript ../../scripts/sbdiexportreannotate.R "{config.dada_ref_taxonomy_dbversion}" ASV_tax_species.tsv dada2 "v2.18.0" "{config.cut_its}"
cp annotation.tsv "$OLDPWD/results/SBDI/annotation.tsv"
'''
tags = ["export"]

[rules.environment]
conda = "envs/sbdiexport.yaml"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "phyloseq"
description = "Phyloseq R object (RDS) from the DADA2 ASV and taxonomy tables"
when = "!config.skip_taxonomy && !config.skip_dada_taxonomy && !config.skip_phyloseq"
input = [
    "results/dada2/ASV_tax_species.sbdi-gtdb_R11-RS232-1.tsv",
    "results/dada2/ASV_table.tsv",
    "{config.metadata_file}",
]
output = [
    "results/phyloseq/dada2_phyloseq.rds",
]
shell = '''
mkdir -p work/phyloseq results/phyloseq
cp {input[0]} work/phyloseq/ASV_tax_species.tsv
cp {input[1]} work/phyloseq/ASV_table.tsv
cp {input[2]} work/phyloseq/metadata.tsv
cd work/phyloseq
Rscript ../../scripts/phyloseq.R dada2 ASV_tax_species.tsv ASV_table.tsv metadata.tsv none.tree
cp dada2_phyloseq.rds "$OLDPWD/results/phyloseq/dada2_phyloseq.rds"
'''
tags = ["reporting"]

[rules.environment]
conda = "envs/phyloseq.yaml"

[rules.resources]
threads = 2
memory = "3G"

# Per-tool R-object variants: upstream mixes EVERY configured taxonomy
# tool into the roobject channels independently (no priority
# exclusions), so these variants key only on their own tool's config
# key. Alt tables pass AS-IS; the placement tree is used when pplace is
# configured (file-exists guarded, consistent with summary_report).
[[rules]]
name = "phyloseq_pplace"
description = "Phyloseq R object (RDS) from the phylogenetic-placement taxonomy"
when = "!config.skip_taxonomy && !config.skip_phyloseq && config.pplace_tree != \"\" && config.pplace_taxonomy != \"\""
input = [
    "results/pplace/reformat_{config.pplace_name}.taxonomy.tsv",
    "results/dada2/ASV_table.tsv",
    "{config.metadata_file}",
    "intermediates/pplace/grafted.newick",
]
output = [
    "results/phyloseq/pplace_phyloseq.rds",
]
shell = '''
mkdir -p work/phyloseq_pplace results/phyloseq
cp {input[0]} work/phyloseq_pplace/taxonomy.tsv
cp {input[1]} work/phyloseq_pplace/ASV_table.tsv
cp {input[2]} work/phyloseq_pplace/metadata.tsv
cp {input[3]} work/phyloseq_pplace/grafted.newick
cd work/phyloseq_pplace
Rscript ../../scripts/phyloseq.R pplace taxonomy.tsv ASV_table.tsv metadata.tsv grafted.newick
cp pplace_phyloseq.rds "$OLDPWD/results/phyloseq/pplace_phyloseq.rds"
'''
tags = ["reporting"]

[rules.environment]
conda = "envs/phyloseq.yaml"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "phyloseq_kraken2"
description = "Phyloseq R object (RDS) from the Kraken2 taxonomy"
when = "!config.skip_taxonomy && !config.skip_phyloseq && config.kraken2_ref_tax_custom != \"\""
input = [
    "results/kraken2/ASV_tax.kraken2.into-qiime2.tsv",
