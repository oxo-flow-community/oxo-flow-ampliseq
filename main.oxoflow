output = ["results/sintax/ASV_tax.sintax_format.tsv"]
shell = '''
mkdir -p work/sintax_format_tax results/sintax
cp {input[0]} work/sintax_format_tax/sintax.tsv
cp {input[1]} work/sintax_format_tax/ASV_tax.fasta
cd work/sintax_format_tax
LEVELS="{config.sintax_assign_taxlevels}"
python3 ../../scripts/convert_sintax_output.py -i sintax.tsv -f ASV_tax.fasta -o sintax_format.tsv -t "${LEVELS:-Kingdom,Phylum,Class,Order,Family,Genus,Species}" -d user_supplied
cp sintax_format.tsv "$OLDPWD/results/sintax/ASV_tax.sintax_format.tsv"
'''
tags = ["sintax", "taxonomy"]

[rules.environment]
singularity = "docker://docker.io/biocontainers/biocontainers:v1.2.0_cv1"

[rules.resources]
threads = 1
memory = "2G"

# ------------------------------------------------------------------
# R69  VSEARCH_LCA_FORMAT_DB  (modules/local/format_taxonomy_vsearch_lca.nf,
#      custom-reference branch)
