cp {input[0]} work/vsearch_lca_format_db/database
cd work/vsearch_lca_format_db
set -- $(head -c2 database | od -An -t u1)
if [ "$#" -ge 2 ] && [ "$1" = "31" ] && [ "$2" = "139" ]; then
