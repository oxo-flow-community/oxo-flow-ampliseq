# ================================================================
# oxo-flow-ampliseq — amplicon sequencing (16S/ITS) analysis
#
# oxo-flow port of nf-core/ampliseq 2.18.0
#   upstream: https://github.com/nf-core/ampliseq (tag 2.18.0,
#   sha 2723d4c298d48321594920d0324697e14d73ee94, MIT license)
#
# Ported default-parameters main path:
#   RENAME_RAW_DATA_FILES -> FASTQC -> CUTADAPT -> DADA2 (quality,
#   trunclen, filterAndTrim, learnErrors, denoise, chimera, stats,
#   merge) -> DADA2 taxonomy (assignTaxonomy + addSpecies) ->
#   QIIME2 import + taxa barplot -> MultiQC
#
# Every rule runs in the workflow workdir; all file paths are
# explicit. Files consumed only between rules live under
# intermediates/, files that upstream publishes live under results/.
# ================================================================

[workflow]
name = "oxo-flow-ampliseq"
version = "0.1.0"
description = "Amplicon sequencing (16S/ITS) analysis with DADA2 and QIIME2 barplots — oxo-flow port of nf-core/ampliseq 2.18.0 (default path: FastQC -> cutadapt -> DADA2 denoise -> DADA2 taxonomy -> QIIME2 barplot -> MultiQC)"
author = "oxo-flow-community"
sample_groups_file = "test/fixtures/groups.tsv"

[config]
# --- primers (upstream default null renders literal "null" adapters;
#     port uses empty strings — see README fidelity table) ---
FW_primer = ""
RV_primer = ""
# --- cutadapt ---
cutadapt_min_overlap = 3
cutadapt_max_error_rate = 0.1
# --- DADA2 filtering / denoising ---
trunc_qmin = 25
trunc_rmin = 0.75
quality_type = "Auto"
truncq = 2
min_len = 50
max_len = "Inf"
max_ee = 2
seed = 100
sample_inference = "independent"   # "independent" | "pooled" | "pseudo"
mergepairs_strategy = "merge"      # "merge" | "consensus" | "concatenate"
# --- DADA2 taxonomy assignment ---
dada_min_boot = 50
dada_taxonomy_rc = false
dada_addspecies_allowmultiple = false
dada_assign_chunksize = 10000
dada_assign_taxlevels = "Domain,Kingdom,Phylum,Class,Order,Family,Genus,Species"
dada_ref_taxonomy = "sbdi-gtdb=R11-RS232-1"
dada_ref_taxonomy_urls = "https://ndownloader.figshare.com/files/64711203,https://ndownloader.figshare.com/files/64711218"
dada_ref_taxonomy_title = "SBDI-GTDB - Sativa curated 16S GTDB database - Release R11-RS232-1"
dada_ref_taxonomy_citation = "Lundin D, Andersson A. SBDI Sativa curated 16S GTDB database. FigShare. doi: 10.17044/scilifelab.14869077.v12"
dada_ref_taxonomy_dbversion = "SBDI-GTDB-R11-RS232-1 (https://figshare.scilifelab.se/articles/dataset/SBDI_Sativa_curated_16S_GTDB_database/14869077/10)"
# --- run / metadata ---
run_id = "1"
metadata_file = "test/fixtures/metadata.tsv"
# raw input dir: point at your real data directory (e.g. "raw") after
# cloning; the default ships the test fixtures so a fresh checkout
# dry-runs cleanly. Files are read as <raw_dir>/<sample>_R1/_R2.fastq.gz.
raw_dir = "test/fixtures/raw"
# --- skip flags (upstream params.skip_*, all default false -> full default path) ---
skip_fastqc = false
skip_multiqc = false
skip_qiime = false
skip_barplot = false
skip_taxonomy = false
skip_dada_taxonomy = false
# the four qiime2 rules run in the quay.io/qiime2/amplicon container
# (~20GB unpacked — needs ~25GB free disk for the pull; there is no
# conda qiime2 on common mirrors). Upstream runs qiime2 always; the
# port gates it (default false) so a fresh clone completes the DADA2
# analysis without the container. Set true (with the disk) to enable.
run_qiime2 = false
# --- ITS branch (upstream params.illumina_pe_its / cut_its /
#     its_partial / its_extractor — all default off -> 16S path) ---
illumina_pe_its = false   # fungal ITS long reads: skip quality-based
                          # truncation (truncLen=0) + a second cutadapt
                          # read-through pass removing revcomp primers
cut_its = "none"          # "none" | "full" | "its1" | "its2"
its_partial = 0           # keep partial ITS hits (ITSx --partial N)
its_extractor = "itsx"    # "itsx" | "itsxrust"
# --- multi-run merge (upstream DADA2_MERGE globs *.stats.tsv /
#     *.ASVtable.rds when several --run_ids are given) ---
merge_runs = false
# --- QIIME2 downstream analyses beyond the taxa barplot (upstream
#     params.skip_qiime_downstream default false; the port gates all
#     of these on run_qiime2 as well) ---
skip_qiime_downstream = false
skip_abundance_tables = false   # feature-table exports (abs/rel)
skip_alpha_rarefaction = false
skip_diversity_indices = false
diversity_rarefaction_depth = 500  # floor for core-metrics depth
qiime_adonis_formula = ""      # comma-separated, e.g. "group"
tax_agglom_min = 2
tax_agglom_max = 6
ancom = false
ancombc = false
ancombc2 = false
ancombc_formula = ""           # comma-separated formulas
ancombc2_formula = ""
ancombc_effect_size = 1
ancombc_significance = 0.05
# --- QIIME2 taxonomy classifier (upstream params.qiime_ref_taxonomy /
#     params.classifier — off by default; DADA2 taxonomy is the
#     default path). qiime_ref_taxonomy trains a Naive-Bayes
#     classifier on the primer-extracted reference below; classifier
#     is a path to a pre-trained .qza (skips training). ---
qiime_ref_taxonomy = ""
qiime_ref_taxonomy_urls = "https://data.qiime2.org/2023.7/common/silva-138-99-seqs.qza,https://data.qiime2.org/2023.7/common/silva-138-99-tax.qza"
classifier = ""
# --- picrust (upstream params.picrust, default false) ---
picrust = false
# --- sbdiexport (upstream params.sbdiexport, default false) ---
sbdiexport = false
# --- robjects + summary report (upstream params.skip_phyloseq /
#     skip_tse / skip_report default to FALSE, i.e. the report and the
#     R objects are produced on every upstream run; the port turns them
#     OFF by default like the other optional branches — flip these to
#     false to enable) ---
skip_phyloseq = true
skip_tse = true
skip_report = true
# --- alternative classification chains (upstream kraken2_taxonomy_wf /
#     VSEARCH_SINTAX / VSEARCH_USEARCHGLOBAL_LCA / PPLACE — off by
#     default, each gated on its *_ref_tax_custom / pplace_tree key) ---
kraken2_ref_tax_custom = ""    # kraken2 db directory or .tar.gz bundle
sintax_ref_tax_custom = ""     # FASTA with SINTAX-formatted headers (plain or gzipped)
vsearch_lca_ref_tax_custom = ""  # FASTA with taxonomy headers (plain or gzipped)
kraken2_confidence = 0.0       # upstream params.kraken2_confidence
kraken2_assign_taxlevels = ""  # upstream default "D,P,C,O,F,G,S" (used when empty)
sintax_assign_taxlevels = ""   # upstream default "Kingdom,Phylum,Class,Order,Family,Genus,Species"
vsearch_lca_assign_taxlevels = ""  # same default as sintax
vsearch_lca_id = 0.9           # upstream params.vsearch_lca_id
vsearch_lca_maxaccepts = 0     # upstream params.vsearch_lca_maxaccepts
vsearch_lca_maxrejects = 0     # upstream params.vsearch_lca_maxrejects
vsearch_lca_lca_cutoff = 0.9   # upstream params.vsearch_lca_lca_cutoff
vsearch_lca_query_cov = 1.0    # upstream params.vsearch_lca_query_cov
# --- PPLACE phylogenetic placement (upstream params.pplace_*; the
#     chain runs when pplace_tree is set — EPA-NG placement of ASVs on a
#     user tree, GAPPA graft/assign/heat-tree, clustalo alignment) ---
pplace_tree = ""               # reference phylogeny (newick)
pplace_aln = ""                # reference alignment matching the tree tips
pplace_taxonomy = ""           # optional reference taxonomy TSV (GAPPA assign)
pplace_name = "user_tree"      # output name prefix (upstream default params.pplace_name ?: 'user_tree')
pplace_model = ""              # phylogenetic model for EPA-NG (--model), e.g. "GTR+F+I+I+R3"
pplace_alnmethod = "clustalo"  # upstream params.pplace_alnmethod; the port implements the clustalo branch

# --- SIDLE multi-region taxonomy (upstream sidle_wf; q2-sidle
#     reconstruction of a multi-region OTU/ASV table, long-read style
#     species identification). Activation key is sidle_ref_tax_custom;
#     per-region parameters are parallel comma-lists positionally
#     aligned with sidle_regions. Upstream passes each region as a
#     tuple (region, trim_length, fw_primer, rv_primer); here the four
#     lists are zipped in the shell. NOTE: like upstream multiregion,
#     ASV post-processing is incompatible with SIDLE — do not combine
#     with vsearch_cluster / ASV length / codon filters. ---
sidle_ref_tax_custom = ""      # headerless db taxonomy txt (seq-id \t lineage) — ACTIVATES the sidle chain
sidle_ref_seq_custom = ""      # unaligned db sequences fasta (matching sidle_ref_tax_custom ids)
sidle_ref_aln_custom = ""      # optional aligned db fasta — enables fragment/seq reconstruction
sidle_ref_tree_custom = ""     # optional SEPP reference tree qza (Greengenes 13_8 / SILVA 128) — enables tree reconstruction
sidle_regions = ""             # comma-separated region names, e.g. "V4,V1V3"
sidle_trim_lengths = ""        # comma-separated trim lengths, positionally aligned with sidle_regions
sidle_fw_primers = ""          # comma-separated forward primers, positionally aligned with sidle_regions
sidle_rv_primers = ""          # comma-separated reverse primers, positionally aligned with sidle_regions
sidle_min_counts = 0           # prefilter: keep samples with >= this many total counts across regions (upstream task.ext.min_counts, default 0)

# Reference database declaration (surfaced in the engine-native versions.yml
# export: `oxo-flow report --versions-yml`). The SBDI-GTDB taxonomy is the
# same db the DADA2 taxonomy rules consume via dada_ref_taxonomy above.
[[reference_db]]
name = "SBDI-GTDB"
version = "R11-RS232-1"
source = "https://ndownloader.figshare.com/files/64711203,https://ndownloader.figshare.com/files/64711218"

[defaults]
threads = 1
memory = "1G"

# ------------------------------------------------------------------
# R1  RENAME_RAW_DATA_FILES  (process_single, nf-core/ubuntu:20.04)
#     Create consistent {sample}_1/_2.fastq.gz soft links
# ------------------------------------------------------------------
[[rules]]
name = "rename_raw_data_files"
description = "Rename raw data files to consistent _1/_2.fastq.gz soft-link names"
input = ["{config.raw_dir}/{sample}_R1.fastq.gz", "{config.raw_dir}/{sample}_R2.fastq.gz"]
output = ["intermediates/renamed/{sample}_1.fastq.gz", "intermediates/renamed/{sample}_2.fastq.gz"]
shell = '''
[ -f "{output[0]}" ] || ln -s "$PWD/{input[0]}" "{output[0]}"
[ -f "{output[1]}" ] || ln -s "$PWD/{input[1]}" "{output[1]}"
'''
tags = ["rename", "preprocessing"]

[rules.environment]
singularity = "docker://quay.io/nf-core/ubuntu:20.04"

[rules.resources]
threads = 1
memory = "1G"

# ------------------------------------------------------------------
# R2  FASTQC  (process_low: 2 cpus / 3G; upstream --memory = 3G/2)
#     Upstream publishes only *.html; the *.zip files feed MultiQC,
#     so the port also declares them at results/fastqc/
# ------------------------------------------------------------------
[[rules]]
name = "fastqc"
description = "FastQC quality control on renamed reads"
when = "!config.skip_fastqc"
input = ["intermediates/renamed/{sample}_1.fastq.gz", "intermediates/renamed/{sample}_2.fastq.gz"]
output = [
    "results/fastqc/{sample}_1_fastqc.html",
    "results/fastqc/{sample}_1_fastqc.zip",
    "results/fastqc/{sample}_2_fastqc.html",
    "results/fastqc/{sample}_2_fastqc.zip",
]
shell = "fastqc --quiet --threads {threads} --memory 1536 -o results/fastqc {input[0]} {input[1]}"
tags = ["qc"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0"

[rules.resources]
threads = 2
memory = "3G"

# ------------------------------------------------------------------
# R3  CUTADAPT_BASIC  (process_medium: 6 cpus / 6G)
#     ext.args: --minimum-length 1 -O 3 -e 0.1 -g {FW} -G {RV}
#               --discard-untrimmed
# ------------------------------------------------------------------
[[rules]]
name = "cutadapt"
description = "Primer trimming with cutadapt on renamed reads"
input = ["intermediates/renamed/{sample}_1.fastq.gz", "intermediates/renamed/{sample}_2.fastq.gz"]
output = [
    "intermediates/cutadapt/{sample}.trimmed_1.trim.fastq.gz",
    "intermediates/cutadapt/{sample}.trimmed_2.trim.fastq.gz",
    "results/cutadapt/{sample}.trimmed.cutadapt.log",
]
shell = """
args=""
[ -n "{config.FW_primer}" ] && args="$args -g {config.FW_primer}"
[ -n "{config.RV_primer}" ] && args="$args -G {config.RV_primer}"
# With no primers configured there is nothing to trim, so nothing may be
# discarded (live: empty-primer default + unconditional --discard-untrimmed
# emptied the fixture — 20-byte gzips, DADA2 saw zero reads).
DISCARD=""
[ -n "$args" ] && DISCARD="--discard-untrimmed"
mkdir -p work/cutadapt
# basic pass (upstream CUTADAPT_BASIC); outputs land in the shared workdir
cutadapt --cores {threads} --minimum-length 1 -O {config.cutadapt_min_overlap} -e {config.cutadapt_max_error_rate} $args $DISCARD -o work/cutadapt/{sample}.basic_1.fastq.gz -p work/cutadapt/{sample}.basic_2.fastq.gz {input[0]} {input[1]} > {output[2]}
# illumina_pe_its: second read-through pass removes the reverse-complement
# primers from the trimmed reads (upstream CUTADAPT_READTHROUGH,
# ext.args -a rv_primer_revcomp -A fw_primer_revcomp); DADA2 then runs
# with truncLen=0 (no quality-based truncation for long ITS reads).
if [ "{config.illumina_pe_its}" = "true" ]; then
    RV_REVCOMP=$(python3 scripts/revcomp.py {config.RV_primer})
    FW_REVCOMP=$(python3 scripts/revcomp.py {config.FW_primer})
    cutadapt --cores {threads} --minimum-length 1 -O {config.cutadapt_min_overlap} -e {config.cutadapt_max_error_rate} -a "$RV_REVCOMP" -A "$FW_REVCOMP" -o {output[0]} -p {output[1]} work/cutadapt/{sample}.basic_1.fastq.gz work/cutadapt/{sample}.basic_2.fastq.gz >> {output[2]}
else
    mv work/cutadapt/{sample}.basic_1.fastq.gz {output[0]}
    mv work/cutadapt/{sample}.basic_2.fastq.gz {output[1]}
fi
"""
tags = ["trimming"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/cutadapt:5.2--py311haab0aaa_0"

[rules.resources]
threads = 6
memory = "6G"

# ------------------------------------------------------------------
# R4  CUTADAPT_SUMMARY  (process_single, biocontainers/python:3.8.3)
#     Parse all cutadapt logs into cutadapt_standard_summary.tsv
# ------------------------------------------------------------------
[[rules]]
name = "cutadapt_summary"
description = "Summarize cutadapt trimming stats from all log files"
input = []
expand_inputs = [
    { pattern = "results/cutadapt/{sample}.trimmed.cutadapt.log", variables = { sample = "config.samples_list" } },
]
output = ["intermediates/cutadapt/cutadapt_standard_summary.tsv"]
shell = "python3 scripts/cutadapt_summary.py paired_end {input} > {output[0]}"
tags = ["summary"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/python:3.8.3"

[rules.resources]
threads = 1
memory = "1G"

# ------------------------------------------------------------------
# R5  CUTADAPT_SUMMARY_MERGE  (process_single, action=copy)
# ------------------------------------------------------------------
[[rules]]
name = "cutadapt_summary_merge"
description = "Publish cutadapt summary as cutadapt_summary.tsv"
input = ["intermediates/cutadapt/cutadapt_standard_summary.tsv"]
output = ["results/cutadapt/cutadapt_summary.tsv"]
shell = "cp {input[0]} {output[0]}"
tags = ["summary"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 1
memory = "1G"

# ------------------------------------------------------------------
# R6/R7  DADA2_QUALITY1  (process_low)  prefix FW / RV
#        plotQualityProfile on trimmed reads
# ------------------------------------------------------------------
[[rules]]
name = "dada2_quality_fw"
description = "DADA2 plotQualityProfile on forward trimmed reads"
input = []
expand_inputs = [
    { pattern = "intermediates/cutadapt/{sample}.trimmed_1.trim.fastq.gz", variables = { sample = "config.samples_list" } },
]
output = [
    "intermediates/dada2/QC/FW_qual_stats.tsv",
    "results/dada2/QC/FW_qual_stats.pdf",
    "results/dada2/QC/svg/FW_qual_stats.svg",
    "results/dada2/args/FW_plotQualityProfile.args.txt",
]
shell = "Rscript scripts/dada2_quality.R FW results/dada2/QC results/dada2/QC/svg results/dada2/args intermediates/dada2/QC ', n = 5e+04, aggregate = TRUE' {input}"
tags = ["qc", "dada2"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "dada2_quality_rv"
description = "DADA2 plotQualityProfile on reverse trimmed reads"
input = []
expand_inputs = [
    { pattern = "intermediates/cutadapt/{sample}.trimmed_2.trim.fastq.gz", variables = { sample = "config.samples_list" } },
]
output = [
    "intermediates/dada2/QC/RV_qual_stats.tsv",
    "results/dada2/QC/RV_qual_stats.pdf",
    "results/dada2/QC/svg/RV_qual_stats.svg",
    "results/dada2/args/RV_plotQualityProfile.args.txt",
]
shell = "Rscript scripts/dada2_quality.R RV results/dada2/QC results/dada2/QC/svg results/dada2/args intermediates/dada2/QC ', n = 5e+04, aggregate = TRUE' {input}"
tags = ["qc", "dada2"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 2
memory = "3G"

# ------------------------------------------------------------------
# R8/R9  TRUNCLEN  (process_single, biocontainers/pandas:1.1.5)
#        Find truncation length from quality stats (25 / 0.75)
# ------------------------------------------------------------------
[[rules]]
name = "trunclen_fw"
description = "Find truncation length for forward reads"
when = "!config.illumina_pe_its"
input = ["intermediates/dada2/QC/FW_qual_stats.tsv"]
output = ["intermediates/dada2/trunclenf.txt"]
shell = "python3 scripts/trunclen.py {input[0]} {config.trunc_qmin} {config.trunc_rmin} > {output[0]}"
tags = ["dada2"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/pandas:1.1.5"

[rules.resources]
threads = 1
memory = "1G"

[[rules]]
name = "trunclen_rv"
description = "Find truncation length for reverse reads"
when = "!config.illumina_pe_its"
input = ["intermediates/dada2/QC/RV_qual_stats.tsv"]
output = ["intermediates/dada2/trunclenr.txt"]
shell = "python3 scripts/trunclen.py {input[0]} {config.trunc_qmin} {config.trunc_rmin} > {output[0]}"
tags = ["dada2"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/pandas:1.1.5"

[rules.resources]
threads = 1
memory = "1G"

# ------------------------------------------------------------------
# R10  DADA2_FILTNTRIM  (process_low: 2 cpus / 3G)
#      filterAndTrim per sample with run-level truncation lengths.
#      Args file is renamed {sample}.filterAndTrim.args.txt because
#      all rules share one workdir (upstream: filterAndTrim.args.txt
#      per isolated work dir).
# ------------------------------------------------------------------
[[rules]]
name = "dada2_filtntrim"
description = "DADA2 filterAndTrim on trimmed reads"
input = [
    "intermediates/cutadapt/{sample}.trimmed_1.trim.fastq.gz",
    "intermediates/cutadapt/{sample}.trimmed_2.trim.fastq.gz",
    "intermediates/dada2/trunclenf.txt",
    "intermediates/dada2/trunclenr.txt",
]
output = [
    "intermediates/dada2/{sample}_1.filt.fastq.gz",
    "intermediates/dada2/{sample}_2.filt.fastq.gz",
    "intermediates/dada2/{sample}.filter_stats.tsv",
    "results/dada2/args/{sample}.filterAndTrim.args.txt",
]
shell = '''
TRUNCLENF=$(cat intermediates/dada2/trunclenf.txt)
TRUNCLENR=$(cat intermediates/dada2/trunclenr.txt)
# illumina_pe_its: no quality-based truncation (upstream sets
# trunclenf/trunclenr to 0 and skips TRUNCLEN entirely)
if [ "{config.illumina_pe_its}" = "true" ]; then
    TRUNCLENF=0
    TRUNCLENR=0
fi
Rscript scripts/dada2_filter_and_trim.R {input[0]} {output[0]} {input[1]} {output[1]} "$TRUNCLENF" "$TRUNCLENR" {threads} {output[2]} {output[3]} {config.quality_type} {config.truncq} {config.min_len} {config.max_len} {config.max_ee}
'''
tags = ["dada2", "filtering"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 2
memory = "3G"

# ------------------------------------------------------------------
# R11/R12  DADA2_QUALITY2  (process_low)  prefix FW_preprocessed /
#          RV_preprocessed on filterAndTrim outputs
# ------------------------------------------------------------------
[[rules]]
name = "dada2_quality_fw_preprocessed"
description = "DADA2 plotQualityProfile on forward filtered reads"
input = []
expand_inputs = [
    { pattern = "intermediates/dada2/{sample}_1.filt.fastq.gz", variables = { sample = "config.samples_list" } },
]
output = [
    "intermediates/dada2/QC/FW_preprocessed_qual_stats.tsv",
    "results/dada2/QC/FW_preprocessed_qual_stats.pdf",
    "results/dada2/QC/svg/FW_preprocessed_qual_stats.svg",
    "results/dada2/args/FW_preprocessed_plotQualityProfile.args.txt",
]
shell = "Rscript scripts/dada2_quality.R FW_preprocessed results/dada2/QC results/dada2/QC/svg results/dada2/args intermediates/dada2/QC ', n = 5e+04, aggregate = TRUE' {input}"
tags = ["qc", "dada2"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "dada2_quality_rv_preprocessed"
description = "DADA2 plotQualityProfile on reverse filtered reads"
input = []
expand_inputs = [
    { pattern = "intermediates/dada2/{sample}_2.filt.fastq.gz", variables = { sample = "config.samples_list" } },
]
output = [
    "intermediates/dada2/QC/RV_preprocessed_qual_stats.tsv",
    "results/dada2/QC/RV_preprocessed_qual_stats.pdf",
    "results/dada2/QC/svg/RV_preprocessed_qual_stats.svg",
    "results/dada2/args/RV_preprocessed_plotQualityProfile.args.txt",
]
shell = "Rscript scripts/dada2_quality.R RV_preprocessed results/dada2/QC results/dada2/QC/svg results/dada2/args intermediates/dada2/QC ', n = 5e+04, aggregate = TRUE' {input}"
tags = ["qc", "dada2"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 2
memory = "3G"

# ------------------------------------------------------------------
# R13  DADA2_ERR  (process_medium: 6 cpus / 6G)
#      learnErrors for forward and reverse reads
# ------------------------------------------------------------------
[[rules]]
name = "dada2_err"
description = "DADA2 learnErrors error models for forward and reverse reads"
input = []
expand_inputs = [
    { pattern = "intermediates/dada2/{sample}_1.filt.fastq.gz", variables = { sample = "config.samples_list" } },
    { pattern = "intermediates/dada2/{sample}_2.filt.fastq.gz", variables = { sample = "config.samples_list" } },
]
output = [
    "intermediates/dada2/{config.run_id}_1.err.rds",
    "intermediates/dada2/{config.run_id}_2.err.rds",
    "results/dada2/log/{config.run_id}.err.log",
    "results/dada2/QC/{config.run_id}_1.err.pdf",
    "results/dada2/QC/{config.run_id}_2.err.pdf",
    "results/dada2/QC/svg/{config.run_id}_1.err.svg",
    "results/dada2/QC/svg/{config.run_id}_2.err.svg",
    "results/dada2/QC/{config.run_id}_1.err.convergence.txt",
    "results/dada2/QC/{config.run_id}_2.err.convergence.txt",
    "results/dada2/args/learnErrors.args.txt",
]
shell = "Rscript scripts/dada2_learn_errors.R {config.run_id} intermediates/dada2 results/dada2/QC results/dada2/QC/svg results/dada2/args results/dada2/log {config.seed} {threads} {config.quality_type} {input}"
tags = ["dada2", "denoising"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 6
memory = "6G"

# ------------------------------------------------------------------
# R14  DADA2_DENOISING  (process_high 10 cpus / 20G + process_long
#      48h + error_retry -> retries = 3)
# ------------------------------------------------------------------
[[rules]]
name = "dada2_denoising"
description = "DADA2 core denoising: dada, mergePairs, makeSequenceTable"
input = [
    "intermediates/dada2/{config.run_id}_1.err.rds",
    "intermediates/dada2/{config.run_id}_2.err.rds",
]
expand_inputs = [
    { pattern = "intermediates/dada2/{sample}_1.filt.fastq.gz", variables = { sample = "config.samples_list" } },
    { pattern = "intermediates/dada2/{sample}_2.filt.fastq.gz", variables = { sample = "config.samples_list" } },
]
output = [
    "intermediates/dada2/{config.run_id}_1.dada.rds",
    "intermediates/dada2/{config.run_id}_2.dada.rds",
    "intermediates/dada2/{config.run_id}.mergers.rds",
    "intermediates/dada2/{config.run_id}.seqtab.rds",
    "results/dada2/log/{config.run_id}.dada.log",
    "results/dada2/args/dada.args.txt",
    "results/dada2/args/mergePairs.args.txt",
]
retries = 3
shell = "Rscript scripts/dada2_denoise.R {config.run_id} intermediates/dada2 results/dada2/log results/dada2/args {input[0]} {input[1]} {config.seed} {config.quality_type} {threads} {config.mergepairs_strategy} {config.sample_inference} intermediates/dada2/*_1.filt.fastq.gz"
tags = ["dada2", "denoising"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 10
memory = "20G"
time_limit = "48h"

# ------------------------------------------------------------------
# R15  DADA2_RMCHIMERA  (process_medium: 6 cpus / 6G)
# ------------------------------------------------------------------
[[rules]]
name = "dada2_rmchimera"
description = "DADA2 removeBimeraDenovo on the sequence table"
input = ["intermediates/dada2/{config.run_id}.seqtab.rds"]
output = [
    "intermediates/dada2/{config.run_id}.ASVtable.rds",
    "results/dada2/args/removeBimeraDenovo.args.txt",
]
shell = "Rscript scripts/dada2_remove_chimera.R {input[0]} {output[0]} {output[1]} {threads} {config.samples_list}"
tags = ["dada2"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 6
memory = "6G"

# ------------------------------------------------------------------
# R16  DADA2_STATS  (process_low: 2 cpus / 3G)
# ------------------------------------------------------------------
[[rules]]
name = "dada2_stats"
description = "Track reads through the pipeline per sample"
input = [
    "intermediates/dada2/{config.run_id}_1.dada.rds",
    "intermediates/dada2/{config.run_id}_2.dada.rds",
    "intermediates/dada2/{config.run_id}.mergers.rds",
    "intermediates/dada2/{config.run_id}.seqtab.rds",
]
expand_inputs = [
    { pattern = "intermediates/dada2/{sample}.filter_stats.tsv", variables = { sample = "config.samples_list" } },
]
output = ["results/dada2/{config.run_id}.stats.tsv"]
shell = "Rscript scripts/dada2_track_stats.R {config.run_id} {output[0]} {input}"
tags = ["dada2", "summary"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 2
memory = "3G"

# ------------------------------------------------------------------
# R17  DADA2_MERGE  (process_low)
#      Merge per-run stats + build DADA2_table / ASV_table / fasta
# ------------------------------------------------------------------
[[rules]]
name = "dada2_merge"
description = "Combine stats files and generate the ASV table, ASV fasta and RDS"
input = [
    "results/dada2/{config.run_id}.stats.tsv",
    "intermediates/dada2/{config.run_id}.ASVtable.rds",
]
output = [
    "results/dada2/DADA2_stats.tsv",
    "results/dada2/DADA2_table.tsv",
    "results/dada2/ASV_table.tsv",
    "results/dada2/ASV_seqs.fasta",
    "results/dada2/DADA2_table.rds",
]
shell = '''
# merge_runs: upstream DADA2_MERGE globs all *.stats.tsv /
# *.ASVtable.rds (one set per --run_id) and merges them
# (unique-rbind stats, mergeSequenceTables for the ASV tables).
if [ "{config.merge_runs}" = "true" ]; then
    Rscript scripts/dada2_merge.R "$(ls results/dada2/*.stats.tsv | tr '\n' ' ')" "$(ls intermediates/dada2/*.ASVtable.rds | tr '\n' ' ')" results/dada2
else
    Rscript scripts/dada2_merge.R "{input[0]}" "{input[1]}" results/dada2
fi
'''
tags = ["dada2", "summary"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 2
memory = "3G"

# ------------------------------------------------------------------
# R18  ITSX_CUTASV  (process_medium, biocontainers/itsx:1.1.3)
#      Cut the ITS region out of full-length ASV sequences. Only one
#      of itsx_cutasv / itsxrust_cutasv runs (its_extractor switch);
#      the selected region fasta is copied to a canonical
#      intermediates/itsx/ path so downstream rules have a static
#      input regardless of cut_its/its_partial.
# ------------------------------------------------------------------
[[rules]]
name = "itsx_cutasv"
description = "Cut ITS region from ASV sequences with ITSx"
when = "config.cut_its != \"none\" && config.its_extractor == \"itsx\""
input = ["results/dada2/ASV_seqs.fasta"]
output = [
    "intermediates/itsx/ASV_ITS_seqs.fasta",
    "results/itsx/ASV_ITS_seqs.summary.txt",
    "results/itsx/ITSx.args.txt",
]
shell = '''
mkdir -p results/itsx intermediates/itsx
SAVE_REGIONS="none"
[ "{config.cut_its}" = "its1" ] && SAVE_REGIONS="ITS1"
[ "{config.cut_its}" = "its2" ] && SAVE_REGIONS="ITS2"
PARTIAL=""
[ "{config.its_partial}" != "0" ] && PARTIAL="--partial {config.its_partial}"
ITSx -i {input[0]} -t all --preserve T --date F --positions F --graphical F --save_regions $SAVE_REGIONS $PARTIAL --cpu {threads} -o results/itsx/ASV_ITS_seqs
# outfile name mirrors upstream (ASV_ITS_seqs.full.fasta / .ITS1.fasta /
# .ITS2.fasta, with .full_and_partial when its_partial is set)
if [ "{config.cut_its}" = "full" ]; then OUTF=ASV_ITS_seqs.full.fasta
elif [ "{config.cut_its}" = "its1" ]; then OUTF=ASV_ITS_seqs.ITS1.fasta
else OUTF=ASV_ITS_seqs.ITS2.fasta; fi
if [ "{config.its_partial}" != "0" ]; then
    if [ "{config.cut_its}" = "full" ]; then OUTF=ASV_ITS_seqs.full_and_partial.fasta
    else OUTF=${OUTF%.fasta}.full_and_partial.fasta; fi
fi
if [ ! -s "results/itsx/$OUTF" ]; then
    echo "ERROR: No ITS regions found by ITSx. You might want to modify --cut_its and/or --its_partial" >&2
    exit 1
fi
cp "results/itsx/$OUTF" {output[0]}
echo -e "ITSx\t-t all --preserve T --date F --positions F --graphical F --save_regions $SAVE_REGIONS $PARTIAL" > {output[2]}
'''

[rules.environment]
singularity = "docker://quay.io/biocontainers/itsx:1.1.3--hdfd78af_1"

[rules.resources]
threads = 6
memory = "6G"

# ------------------------------------------------------------------
# R19  ITSXRUST_CUTASV  (process_medium,
#      quay.io/biocontainers/itsxrust:0.2.2--hdd79491_1)
#      Same role as itsx_cutasv with the faster Rust implementation;
#      produces ITS1/ITS2/full files named like ITSx's and a
#      ITSx-compatible summary from the QC JSON.
# ------------------------------------------------------------------
[[rules]]
name = "itsxrust_cutasv"
description = "Cut ITS region from ASV sequences with ITSxRust"
when = "config.cut_its != \"none\" && config.its_extractor == \"itsxrust\""
input = ["results/dada2/ASV_seqs.fasta"]
output = [
    "intermediates/itsx/ASV_ITS_seqs.fasta",
    "results/itsx/ASV_ITS_seqs.summary.txt",
    "results/itsx/ITSxRust.args.txt",
]
shell = '''
mkdir -p results/itsx intermediates/itsx work
HMM_PATH="${CONDA_PREFIX:-/usr/local}/share/itsxrust/hmm/F.hmm"
# Run ITSxRust with --region all so we always get full + ITS1 + ITS2
# outputs (mirrors ITSx behavior which always writes all region files)
itsxrust extract --input {input[0]} --hmm "$HMM_PATH" --hmmer-cpu {threads} --output work/itsx_rust_out --region all --output-format fasta --qc-json work/itsxrust_qc.json
# ITSxRust --output is a file prefix, so the region files land at
# work/itsx_rust_out.{its1,its2,full}.fasta. Rename ITS1/ITS2 to ITSx
# naming (uppercase) when copying into results/itsx/.
if [ -f work/itsx_rust_out.its1.fasta ]; then cp work/itsx_rust_out.its1.fasta results/itsx/ASV_ITS_seqs.ITS1.fasta; fi
if [ -f work/itsx_rust_out.its2.fasta ]; then cp work/itsx_rust_out.its2.fasta results/itsx/ASV_ITS_seqs.ITS2.fasta; fi
if [ -f work/itsx_rust_out.full.fasta ]; then cp work/itsx_rust_out.full.fasta results/itsx/ASV_ITS_seqs.full.fasta; fi
# Handle partial naming: if its_partial is used, the workflow expects
# filenames like ASV_ITS_seqs.full_and_partial.fasta
if [ "{config.its_partial}" != "0" ]; then
    if [ -f results/itsx/ASV_ITS_seqs.full.fasta ]; then cp results/itsx/ASV_ITS_seqs.full.fasta results/itsx/ASV_ITS_seqs.full_and_partial.fasta; fi
    if [ -f results/itsx/ASV_ITS_seqs.ITS1.fasta ]; then cp results/itsx/ASV_ITS_seqs.ITS1.fasta results/itsx/ASV_ITS_seqs.ITS1.full_and_partial.fasta; fi
    if [ -f results/itsx/ASV_ITS_seqs.ITS2.fasta ]; then cp results/itsx/ASV_ITS_seqs.ITS2.fasta results/itsx/ASV_ITS_seqs.ITS2.full_and_partial.fasta; fi
fi
# Strip ITSxRust coordinate annotations from FASTA headers (for now)
# e.g. ">seq1|full:47-433" becomes ">seq1"
for f in results/itsx/ASV_ITS_seqs.*.fasta; do
    [ -f "$f" ] && sed -i 's/|[a-z]*[0-9]*:[0-9]*-[0-9]*//' "$f"
done
# Select the requested region into the canonical intermediate path
if [ "{config.cut_its}" = "full" ]; then OUTF=ASV_ITS_seqs.full.fasta
elif [ "{config.cut_its}" = "its1" ]; then OUTF=ASV_ITS_seqs.ITS1.fasta
else OUTF=ASV_ITS_seqs.ITS2.fasta; fi
if [ "{config.its_partial}" != "0" ]; then
    if [ "{config.cut_its}" = "full" ]; then OUTF=ASV_ITS_seqs.full_and_partial.fasta
    else OUTF=${OUTF%.fasta}.full_and_partial.fasta; fi
fi
if [ ! -s "results/itsx/$OUTF" ]; then
    echo "ERROR: No ITS regions found by ITSxRust. You might want to modify --cut_its, --its_partial, or --its_extractor options" >&2
    exit 1
fi
cp "results/itsx/$OUTF" {output[0]}
# Generate ITSx-compatible summary from ITSxRust QC JSON
if [ -f work/itsxrust_qc.json ]; then
    total=$(grep -o '"total_reads":[0-9]*' work/itsxrust_qc.json | grep -o '[0-9]*')
    kept=$(grep -o '"kept":[0-9]*' work/itsxrust_qc.json | grep -o '[0-9]*')
    skipped=$(grep -o '"skipped":[0-9]*' work/itsxrust_qc.json | grep -o '[0-9]*')
    echo "ITSxRust extraction summary" > {output[1]}
    echo "Number of sequences in input file: ${total:-0}" >> {output[1]}
    echo "Sequences detected as ITS by ITSx: ${kept:-0}" >> {output[1]}
    echo "Number of sequences skipped: ${skipped:-0}" >> {output[1]}
else
    echo "ITSxRust: QC JSON not available" > {output[1]}
fi
echo -e "ITSxRust\t" > {output[2]}
'''

[rules.environment]
singularity = "docker://quay.io/biocontainers/itsxrust:0.2.2--hdd79491_1"

[rules.resources]
threads = 6
memory = "6G"

# ------------------------------------------------------------------
# R20  FILTER_LEN_ITSX  (process_single, biostrings)
#      Length-filter the ITS-cut ASVs to 50..1000000 bp and restrict
#      the ASV table to the surviving ASVs (upstream
#      FILTER_LEN_ITSX ext.min_len_asv = 50). Runs in a scratch dir
#      (the R script writes fixed file names).
# ------------------------------------------------------------------
[[rules]]
name = "filter_len_itsx"
description = "Length-filter ITS-cut ASV sequences (50 bp minimum) and table"
when = "config.cut_its != \"none\""
input = ["intermediates/itsx/ASV_ITS_seqs.fasta", "results/dada2/ASV_table.tsv"]
output = [
    "intermediates/dada2/ASV_ITS_seqs.len.fasta",
    "intermediates/dada2/ASV_table.len.tsv",
    "results/itsx/ASV_len_orig.tsv",
    "results/itsx/ASV_len_filt.tsv",
    "results/itsx/stats.len.tsv",
]
shell = '''
mkdir -p work/filter_len_itsx
cp {input[0]} work/filter_len_itsx/ASV_ITS_seqs.fasta
cp {input[1]} work/filter_len_itsx/ASV_table.tsv
cd work/filter_len_itsx
Rscript ../../scripts/filter_len.R ASV_ITS_seqs.fasta ASV_table.tsv
cp ASV_seqs.len.fasta "$OLDPWD/intermediates/dada2/ASV_ITS_seqs.len.fasta"
cp ASV_table.len.tsv "$OLDPWD/intermediates/dada2/ASV_table.len.tsv"
cp ASV_len_orig.tsv ASV_len_filt.tsv stats.len.tsv "$OLDPWD/results/itsx/"
'''
tags = ["its", "dada2"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 2
memory = "3G"

# ------------------------------------------------------------------
# R21  MERGE_STATS_STD  (process_single)
#      Merge cutadapt summary with DADA2 stats -> overall_summary.tsv
# ------------------------------------------------------------------
[[rules]]
name = "merge_stats"
description = "Merge cutadapt and DADA2 statistics into overall_summary.tsv"
input = ["results/cutadapt/cutadapt_summary.tsv", "results/dada2/DADA2_stats.tsv"]
output = ["results/overall_summary.tsv"]
shell = "Rscript scripts/merge_stats.R {input[0]} {input[1]} {output[0]}"
tags = ["summary"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 1
memory = "1G"

# ------------------------------------------------------------------
# R22  Reference database download (system backend; upstream does this
#      in the Nextflow launcher via file(url), outside the container)
# ------------------------------------------------------------------
[[rules]]
name = "download_taxonomy_db"
description = "Download the SBDI-GTDB reference database files (assignTaxonomy + addSpecies)"
when = "!config.skip_taxonomy && !config.skip_dada_taxonomy"
input = []
output = [
    "intermediates/dada2/db/64711203.fna.gz",
    "intermediates/dada2/db/64711218.fna.gz",
]
shell = '''
mkdir -p intermediates/dada2/db
curl -fsSL -o {output[0]} $(echo {config.dada_ref_taxonomy_urls} | cut -d, -f1)
curl -fsSL -o {output[1]} $(echo {config.dada_ref_taxonomy_urls} | cut -d, -f2)
'''
tags = ["reference"]

[rules.resources]
threads = 1
memory = "1G"

# ------------------------------------------------------------------
# R23  FORMAT_TAXONOMY  (process_single; port pins nf-core/ubuntu:20.04 —
#      upstream declares biocontainers:v1.2.0_cv1, see README fidelity
#      table)
#      Reformat downloaded DB files to assignTaxonomy.fna /
#      addSpecies.fna + ref_taxonomy info file.
#      Runs in a scratch dir because the reformat script globs "*".
# ------------------------------------------------------------------
[[rules]]
name = "format_taxonomy"
description = "Reformat SBDI-GTDB reference database files for DADA2"
when = "!config.skip_taxonomy && !config.skip_dada_taxonomy"
input = ["intermediates/dada2/db/64711203.fna.gz", "intermediates/dada2/db/64711218.fna.gz"]
output = [
    "intermediates/dada2/assignTaxonomy.fna",
    "intermediates/dada2/addSpecies.fna",
    "results/dada2/ref_taxonomy.sbdi-gtdb_R11-RS232-1.txt",
]
shell = '''
mkdir -p work/format_taxonomy
cp {input[0]} {input[1]} work/format_taxonomy/
cd work/format_taxonomy
sh ../../scripts/taxref_reformat_sbdi-gtdb.sh
cp assignTaxonomy.fna addSpecies.fna "$OLDPWD/intermediates/dada2/"
echo -e "--dada_ref_taxonomy: sbdi-gtdb=R11-RS232-1\\n" > "$OLDPWD/results/dada2/ref_taxonomy.sbdi-gtdb_R11-RS232-1.txt"
echo -e "Title: SBDI-GTDB - Sativa curated 16S GTDB database - Release R11-RS232-1\\n" >> "$OLDPWD/results/dada2/ref_taxonomy.sbdi-gtdb_R11-RS232-1.txt"
echo -e "Citation: Lundin D, Andersson A. SBDI Sativa curated 16S GTDB database. FigShare. doi: 10.17044/scilifelab.14869077.v12\\n" >> "$OLDPWD/results/dada2/ref_taxonomy.sbdi-gtdb_R11-RS232-1.txt"
echo "All entries: file:[https://ndownloader.figshare.com/files/64711203, https://ndownloader.figshare.com/files/64711218], fmtscript:taxref_reformat_sbdi-gtdb.sh, taxlevels:Domain,Kingdom,Phylum,Class,Order,Family,Genus,Species, dbversion:SBDI-GTDB-R11-RS232-1, title:SBDI-GTDB - Sativa curated 16S GTDB database - Release R11-RS232-1, citation:Lundin D, Andersson A. SBDI Sativa curated 16S GTDB database. FigShare. doi: 10.17044/scilifelab.14869077.v12" >> "$OLDPWD/results/dada2/ref_taxonomy.sbdi-gtdb_R11-RS232-1.txt"
'''
tags = ["reference"]

[rules.environment]
singularity = "docker://quay.io/nf-core/ubuntu:20.04"

[rules.resources]
threads = 1
memory = "1G"

# ------------------------------------------------------------------
# R24  DADA2_TAXONOMY + DADA2_ADDSPECIES + collectFile
#      (process_high 10 cpus/20G; addSpecies 1 cpu/50G process_long)
#      Upstream splits ASV_seqs.fasta into chunks of 10000 and runs
#      assignTaxonomy + addSpecies per chunk, then concatenates with
#      header + sorted rows. The port merges the two processes into
#      one rule with an awk split and per-chunk Rscript calls —
#      same chunks (ASV_seqs_<n>.fasta), same outputs, same
#      concatenation semantics. See README fidelity table.
# ------------------------------------------------------------------
[[rules]]
name = "dada2_taxonomy"
description = "DADA2 assignTaxonomy + addSpecies with 10000-sequence chunking"
when = "!config.skip_taxonomy && !config.skip_dada_taxonomy && config.cut_its == \"none\""
input = [
    "results/dada2/ASV_seqs.fasta",
    "intermediates/dada2/assignTaxonomy.fna",
    "intermediates/dada2/addSpecies.fna",
]
output = [
    "results/dada2/ASV_tax.sbdi-gtdb_R11-RS232-1.tsv",
    "results/dada2/ASV_tax_species.sbdi-gtdb_R11-RS232-1.tsv",
    "results/dada2/args/assignTaxonomy.args.txt",
    "results/dada2/args/addSpecies.args.txt",
]
shell = '''
mkdir -p work/dada2_taxonomy
awk 'BEGIN{n=0;c=0} /^>/{n++; if (n % {config.dada_assign_chunksize} == 1) {c++; if (file) close(file); file=sprintf("work/dada2_taxonomy/ASV_seqs_%d.fasta", c)}} {print > file}' {input[0]}
for chunk in work/dada2_taxonomy/ASV_seqs_*.fasta; do
    Rscript scripts/dada2_assign_taxonomy.R "$chunk" {input[1]} ".ASV_tax.sbdi-gtdb_R11-RS232-1" "{config.dada_assign_taxlevels}" {config.seed} {threads} {config.dada_min_boot} {config.dada_taxonomy_rc} work/dada2_taxonomy
    Rscript scripts/dada2_add_species.R "$(basename "$chunk" .fasta).ASV_tax.sbdi-gtdb_R11-RS232-1.rds" {input[2]} "{config.dada_assign_taxlevels}" {config.seed} {config.dada_addspecies_allowmultiple} {config.dada_taxonomy_rc} work/dada2_taxonomy
done
head -1 work/dada2_taxonomy/ASV_seqs_1.ASV_tax.sbdi-gtdb_R11-RS232-1.tsv > {output[0]}
for f in work/dada2_taxonomy/ASV_seqs_*.ASV_tax.sbdi-gtdb_R11-RS232-1.tsv; do tail -n +2 "$f"; done | sort >> {output[0]}
head -1 work/dada2_taxonomy/ASV_seqs_1.species.tsv > {output[1]}
for f in work/dada2_taxonomy/ASV_seqs_*.species.tsv; do tail -n +2 "$f"; done | sort >> {output[1]}
printf 'assignTaxonomy\\tminBoot = {config.dada_min_boot},tryRC = {config.dada_taxonomy_rc}\\ntaxlevels\\tc("{config.dada_assign_taxlevels}")\\nseed\\t{config.seed}\\n' > {output[2]}
printf 'addSpecies\\tn = 1e5,tryRC = {config.dada_taxonomy_rc}\\ntaxlevels\\tc("{config.dada_assign_taxlevels}")\\nseed\\t{config.seed}\\n' > {output[3]}
'''
tags = ["dada2", "taxonomy"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 10
memory = "20G"
time_limit = "24h"

# ------------------------------------------------------------------
# R25  DADA2_TAXONOMY_WF + DADA2_ADDSPECIES + FORMAT_TAXRESULTS
#      (ITS branch: cut_its != "none"). assignTaxonomy + addSpecies run
#      on the ITS-cut, length-filtered ASVs (chunked like the default
#      path); the resulting tables are mapped back onto the full-length
#      ASV sequences (upstream FORMAT_TAXRESULTS:
#      add_full_sequence_to_taxfile.py) and published under the same
#      results/dada2/ASV_tax*.tsv names as the default path.
# ------------------------------------------------------------------
[[rules]]
name = "dada2_taxonomy_its"
description = "DADA2 taxonomy on ITS-cut ASVs, mapped back to full ASVs"
when = "!config.skip_taxonomy && !config.skip_dada_taxonomy && config.cut_its != \"none\""
input = [
    "intermediates/dada2/ASV_ITS_seqs.len.fasta",
    "results/dada2/ASV_seqs.fasta",
    "intermediates/dada2/assignTaxonomy.fna",
    "intermediates/dada2/addSpecies.fna",
]
output = [
    "results/dada2/ASV_tax.sbdi-gtdb_R11-RS232-1.tsv",
    "results/dada2/ASV_tax_species.sbdi-gtdb_R11-RS232-1.tsv",
    "results/dada2/args/assignTaxonomy.args.txt",
    "results/dada2/args/addSpecies.args.txt",
]
shell = '''
mkdir -p work/dada2_taxonomy_its
awk 'BEGIN{n=0;c=0} /^>/{n++; if (n % {config.dada_assign_chunksize} == 1) {c++; if (file) close(file); file=sprintf("work/dada2_taxonomy_its/ASV_ITS_seqs_%d.fasta", c)}} {print > file}' {input[0]}
for chunk in work/dada2_taxonomy_its/ASV_ITS_seqs_*.fasta; do
    Rscript scripts/dada2_assign_taxonomy.R "$chunk" {input[2]} ".ASV_ITS_tax.sbdi-gtdb_R11-RS232-1" "{config.dada_assign_taxlevels}" {config.seed} {threads} {config.dada_min_boot} {config.dada_taxonomy_rc} work/dada2_taxonomy_its
    Rscript scripts/dada2_add_species.R "$(basename "$chunk" .fasta).ASV_ITS_tax.sbdi-gtdb_R11-RS232-1.rds" {input[3]} "{config.dada_assign_taxlevels}" {config.seed} {config.dada_addspecies_allowmultiple} {config.dada_taxonomy_rc} work/dada2_taxonomy_its
done
head -1 work/dada2_taxonomy_its/ASV_ITS_seqs_1.ASV_ITS_tax.sbdi-gtdb_R11-RS232-1.tsv > work/dada2_taxonomy_its/ASV_ITS_tax.sbdi-gtdb_R11-RS232-1.tsv
for f in work/dada2_taxonomy_its/ASV_ITS_seqs_*.ASV_ITS_tax.sbdi-gtdb_R11-RS232-1.tsv; do tail -n +2 "$f"; done | sort >> work/dada2_taxonomy_its/ASV_ITS_tax.sbdi-gtdb_R11-RS232-1.tsv
head -1 work/dada2_taxonomy_its/ASV_ITS_seqs_1.species.tsv > work/dada2_taxonomy_its/ASV_ITS_tax_species.sbdi-gtdb_R11-RS232-1.tsv
for f in work/dada2_taxonomy_its/ASV_ITS_seqs_*.species.tsv; do tail -n +2 "$f"; done | sort >> work/dada2_taxonomy_its/ASV_ITS_tax_species.sbdi-gtdb_R11-RS232-1.tsv
# Map the ITS-cut taxonomy back onto the full-length ASVs
python3 scripts/add_full_sequence_to_taxfile.py work/dada2_taxonomy_its/ASV_ITS_tax.sbdi-gtdb_R11-RS232-1.tsv {input[1]} {output[0]}
python3 scripts/add_full_sequence_to_taxfile.py work/dada2_taxonomy_its/ASV_ITS_tax_species.sbdi-gtdb_R11-RS232-1.tsv {input[1]} {output[1]}
printf 'assignTaxonomy\tminBoot = {config.dada_min_boot},tryRC = {config.dada_taxonomy_rc}\ntaxlevels\tc("{config.dada_assign_taxlevels}")\nseed\t{config.seed}\n' > {output[2]}
printf 'addSpecies\tn = 1e5,tryRC = {config.dada_taxonomy_rc}\ntaxlevels\tc("{config.dada_assign_taxlevels}")\nseed\t{config.seed}\n' > {output[3]}
'''
tags = ["dada2", "taxonomy", "its"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 10
memory = "20G"
time_limit = "24h"

# ------------------------------------------------------------------
# R26-R31  QIIME2 import + taxa barplot  (process_low, qiime2:2026.4)
#          Minimal QIIME2 slice needed for the default-path barplot.
#          run_qiime2 gates all four; skip_taxonomy/skip_dada_taxonomy
#          additionally gate intax + barplot (upstream: empty
#          taxonomy channel skips them).
# ------------------------------------------------------------------
[[rules]]
name = "qiime2_inasv"
description = "Import ASV table into QIIME2 FeatureTable[Frequency]"
when = "!config.skip_qiime && config.run_qiime2 && config.cut_its == \"none\" && config.sidle_ref_tax_custom == \"\""
input = ["results/dada2/DADA2_table.tsv"]
output = ["intermediates/qiime2/table.qza"]
shell = '''
export MPLCONFIGDIR="work/qiime2_inasv/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_inasv/numbacache"
sed '/^# Constructed from biom file/d' {input[0]} > work/qiime2_inasv/biom-table.txt
biom convert -i work/qiime2_inasv/biom-table.txt -o work/qiime2_inasv/table.biom --table-type="OTU table" --to-hdf5
qiime tools import --input-path work/qiime2_inasv/table.biom --type 'FeatureTable[Frequency]' --input-format BIOMV210Format --output-path {output[0]}
'''
tags = ["qiime2"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "qiime2_inseq"
description = "Import ASV sequences into QIIME2 FeatureData[Sequence]"
when = "!config.skip_qiime && config.run_qiime2 && config.cut_its == \"none\""
input = ["results/dada2/ASV_seqs.fasta"]
output = ["intermediates/qiime2/rep-seqs.qza"]
shell = '''
export MPLCONFIGDIR="work/qiime2_inseq/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_inseq/numbacache"
qiime tools import --input-path {input[0]} --type 'FeatureData[Sequence]' --output-path {output[0]}
'''
tags = ["qiime2"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

# ITS branch: import the length-filtered ITS table / sequences into the
# same intermediates/qiime2/ paths as the default branch (the gates of
# qiime2_inasv/qiime2_inseq and these two are mutually exclusive, so the
# shared output paths never race).
[[rules]]
name = "qiime2_inasv_its"
description = "Import ITS length-filtered ASV table into QIIME2"
when = "!config.skip_qiime && config.run_qiime2 && config.cut_its != \"none\""
input = ["intermediates/dada2/ASV_table.len.tsv"]
output = ["intermediates/qiime2/table.qza"]
shell = '''
export MPLCONFIGDIR="work/qiime2_inasv_its/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_inasv_its/numbacache"
sed '/^# Constructed from biom file/d' {input[0]} > work/qiime2_inasv_its/biom-table.txt
biom convert -i work/qiime2_inasv_its/biom-table.txt -o work/qiime2_inasv_its/table.biom --table-type="OTU table" --to-hdf5
qiime tools import --input-path work/qiime2_inasv_its/table.biom --type 'FeatureTable[Frequency]' --input-format BIOMV210Format --output-path {output[0]}
'''
tags = ["qiime2", "its"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "qiime2_inseq_its"
description = "Import ITS length-filtered ASV sequences into QIIME2"
when = "!config.skip_qiime && config.run_qiime2 && config.cut_its != \"none\""
input = ["intermediates/dada2/ASV_ITS_seqs.len.fasta"]
output = ["intermediates/qiime2/rep-seqs.qza"]
shell = '''
export MPLCONFIGDIR="work/qiime2_inseq_its/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_inseq_its/numbacache"
qiime tools import --input-path {input[0]} --type 'FeatureData[Sequence]' --output-path {output[0]}
'''
tags = ["qiime2", "its"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "qiime2_intax"
description = "Import DADA2 taxonomy into QIIME2 FeatureData[Taxonomy]"
when = "!config.skip_qiime && !config.skip_taxonomy && !config.skip_dada_taxonomy && config.run_qiime2 && config.qiime_ref_taxonomy == \"\" && config.classifier == \"\" && (config.pplace_tree == \"\" || config.pplace_taxonomy == \"\") && config.sidle_ref_tax_custom == \"\""
input = ["results/dada2/ASV_tax_species.sbdi-gtdb_R11-RS232-1.tsv"]
output = ["intermediates/qiime2/taxonomy.qza"]
shell = '''
export MPLCONFIGDIR="work/qiime2_intax/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_intax/numbacache"
mkdir -p work/qiime2_intax
Rscript scripts/parse_dada2_taxonomy.r {input[0]} work/qiime2_intax/tax.tsv
qiime tools import --type 'FeatureData[Taxonomy]' --input-format HeaderlessTSVTaxonomyFormat --input-path work/qiime2_intax/tax.tsv --output-path {output[0]}
'''
tags = ["qiime2"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

# Alternative-classification intax variants: each imports its tool's
# taxonomy table into the SHARED intermediates/qiime2/taxonomy.qza path.
# The when-gates encode the upstream taxonomy dispatch priority
# (ampliseq.nf 936-975): SIDLE (multiregion) > pplace > dada2 > sintax
# > kraken2 > native qiime2 > vsearch_lca — a rule only excludes the
# tools ranked ABOVE it.
[[rules]]
name = "qiime2_intax_pplace"
description = "Import phylogenetic-placement taxonomy into QIIME2 FeatureData[Taxonomy]"
when = "config.pplace_tree != \"\" && config.pplace_taxonomy != \"\" && config.run_qiime2 && !config.skip_qiime && !config.skip_taxonomy && config.sidle_ref_tax_custom == \"\""
input = ["results/pplace/{config.pplace_name}.taxonomy.tsv"]
output = ["intermediates/qiime2/taxonomy.qza"]
shell = '''
export MPLCONFIGDIR="work/qiime2_intax_pplace/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_intax_pplace/numbacache"
mkdir -p work/qiime2_intax_pplace
Rscript scripts/parse_dada2_taxonomy.r {input[0]} work/qiime2_intax_pplace/tax.tsv
qiime tools import --type 'FeatureData[Taxonomy]' --input-format HeaderlessTSVTaxonomyFormat --input-path work/qiime2_intax_pplace/tax.tsv --output-path {output[0]}
'''
tags = ["qiime2"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "qiime2_intax_sintax"
description = "Import SINTAX taxonomy into QIIME2 FeatureData[Taxonomy]"
when = "config.sintax_ref_tax_custom != \"\" && config.run_qiime2 && !config.skip_qiime && !config.skip_taxonomy && (config.pplace_tree == \"\" || config.pplace_taxonomy == \"\") && config.skip_dada_taxonomy && config.sidle_ref_tax_custom == \"\""
input = ["results/sintax/ASV_tax.sintax_format.tsv"]
output = ["intermediates/qiime2/taxonomy.qza"]
shell = '''
export MPLCONFIGDIR="work/qiime2_intax_sintax/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_intax_sintax/numbacache"
mkdir -p work/qiime2_intax_sintax
Rscript scripts/parse_dada2_taxonomy.r {input[0]} work/qiime2_intax_sintax/tax.tsv
qiime tools import --type 'FeatureData[Taxonomy]' --input-format HeaderlessTSVTaxonomyFormat --input-path work/qiime2_intax_sintax/tax.tsv --output-path {output[0]}
'''
tags = ["qiime2"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "qiime2_intax_kraken2"
description = "Import Kraken2 taxonomy into QIIME2 FeatureData[Taxonomy]"
when = "config.kraken2_ref_tax_custom != \"\" && config.run_qiime2 && !config.skip_qiime && !config.skip_taxonomy && (config.pplace_tree == \"\" || config.pplace_taxonomy == \"\") && config.skip_dada_taxonomy && config.sintax_ref_tax_custom == \"\" && config.sidle_ref_tax_custom == \"\""
input = ["results/kraken2/ASV_tax.kraken2.into-qiime2.tsv"]
output = ["intermediates/qiime2/taxonomy.qza"]
shell = '''
export MPLCONFIGDIR="work/qiime2_intax_kraken2/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_intax_kraken2/numbacache"
mkdir -p work/qiime2_intax_kraken2
# upstream QIIME2_INTAX passes an empty script for kraken2: cp passthrough
# (the converter TSV keeps its header row; imported as headerless, the
# quirk upstream also carries)
cp {input[0]} work/qiime2_intax_kraken2/tax.tsv
qiime tools import --type 'FeatureData[Taxonomy]' --input-format HeaderlessTSVTaxonomyFormat --input-path work/qiime2_intax_kraken2/tax.tsv --output-path {output[0]}
'''
tags = ["qiime2"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "qiime2_intax_vsearch_lca"
description = "Import VSEARCH LCA taxonomy into QIIME2 FeatureData[Taxonomy]"
when = "config.vsearch_lca_ref_tax_custom != \"\" && config.run_qiime2 && !config.skip_qiime && !config.skip_taxonomy && (config.pplace_tree == \"\" || config.pplace_taxonomy == \"\") && config.skip_dada_taxonomy && config.sintax_ref_tax_custom == \"\" && config.kraken2_ref_tax_custom == \"\" && config.qiime_ref_taxonomy == \"\" && config.classifier == \"\" && config.sidle_ref_tax_custom == \"\""
input = ["results/vsearch_lca/ASV_tax.vsearch_lca_format.tsv"]
output = ["intermediates/qiime2/taxonomy.qza"]
shell = '''
export MPLCONFIGDIR="work/qiime2_intax_vsearch_lca/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_intax_vsearch_lca/numbacache"
mkdir -p work/qiime2_intax_vsearch_lca
Rscript scripts/parse_dada2_taxonomy.r {input[0]} work/qiime2_intax_vsearch_lca/tax.tsv
qiime tools import --type 'FeatureData[Taxonomy]' --input-format HeaderlessTSVTaxonomyFormat --input-path work/qiime2_intax_vsearch_lca/tax.tsv --output-path {output[0]}
'''
tags = ["qiime2"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

[[rules]]
name = "qiime2_barplot"
description = "QIIME2 taxa barplot visualization and export"
when = "!config.skip_qiime && !config.skip_taxonomy && (!config.skip_dada_taxonomy || (config.pplace_tree != \"\" && config.pplace_taxonomy != \"\") || config.sintax_ref_tax_custom != \"\" || config.kraken2_ref_tax_custom != \"\" || config.qiime_ref_taxonomy != \"\" || config.classifier != \"\" || config.vsearch_lca_ref_tax_custom != \"\" || config.sidle_ref_tax_custom != \"\") && !config.skip_barplot && config.run_qiime2"
input = ["{config.metadata_file}", "intermediates/qiime2/table.qza", "intermediates/qiime2/taxonomy.qza"]
output = [
    "results/qiime2/barplot/index.html",
    "results/qiime2/barplot/barplot.html",
]
shell = '''
export XDG_CONFIG_HOME="work/qiime2_barplot/xdgconfig"
export MPLCONFIGDIR="work/qiime2_barplot/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_barplot/numbacache"
qiime taxa barplot --i-table {input[1]} --i-taxonomy {input[2]} --m-metadata-file {input[0]} --o-visualization work/qiime2_barplot/taxa-bar-plots.qzv --verbose
qiime tools export --input-path work/qiime2_barplot/taxa-bar-plots.qzv --output-path results/qiime2/barplot
'''
tags = ["qiime2", "visualization"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

# ------------------------------------------------------------------
# R32-R47  QIIME2 downstream analyses (upstream: subworkflows
#          qiime2_diversity.nf / qiime2_export.nf / qiime2_ancom.nf /
#          qiime2_taxonomy.nf + qiime2_preptax.nf).
#          All gated on run_qiime2 (like the import rules above) plus
#          !skip_qiime_downstream and their own skip/switch flags,
#          matching upstream params. The R metadata scripts and the
#          count_table_minmax_reads.py helper are verbatim upstream
#          bin/ scripts; category fan-out is done in-shell with a
#          loop (upstream uses channel combine fan-out).
#          NOTE: rules whose outputs are data-dependent (metadata
#          categories, tax_agglom levels) declare the file set for
#          the default fixture/parameters; other metadata or
#          tax_agglom_min/max values change the produced files.
# ------------------------------------------------------------------

# upstream METADATA_ALL + METADATA_PAIRWISE (bin/metadata_all.r and
# bin/metadata_pairwise.r): non-numeric, non-unique metadata columns,
# all values occurring >= 2 times (pairwise) / any (all). Runs in the
# R conda env because the qiime2 container has no Rscript.
[[rules]]
name = "qiime2_metadata_categories"
description = "Select metadata categories for QIIME2 diversity and ANCOM"
when = "config.run_qiime2 && !config.skip_qiime_downstream && (config.ancom || config.ancombc || config.ancombc2 || !config.skip_diversity_indices)"
input = ["{config.metadata_file}"]
output = [
    "intermediates/qiime2/categories_all.txt",
    "intermediates/qiime2/categories_pairwise.txt",
]
shell = '''
mkdir -p intermediates/qiime2
Rscript scripts/metadata_all.r {input[0]} > {output[0]}
Rscript scripts/metadata_pairwise.r {input[0]} > {output[1]}
'''
tags = ["qiime2", "metadata"]

[rules.environment]
conda = "envs/dada2.yaml"

[rules.resources]
threads = 1
memory = "1G"

# QIIME2_TREE: mafft -> mask -> fasttree -> midpoint-root. With
# pplace configured the gappa-grafted placement tree replaces this
# de-novo path (mutually exclusive via the pplace_tree gate; the
# pplace tree then feeds rarefaction/diversity through
# qiime2_intree_pplace below).
[[rules]]
name = "qiime2_diversity_tree"
description = "Build rooted phylogenetic tree from representative sequences"
when = "config.run_qiime2 && !config.skip_qiime_downstream && (!config.skip_alpha_rarefaction || !config.skip_diversity_indices) && config.pplace_tree == \"\" && config.sidle_ref_tree_custom == \"\""
input = ["intermediates/qiime2/rep-seqs.qza"]
output = [
    "intermediates/qiime2/rooted-tree.qza",
    "results/qiime2/phylogenetic_tree/tree.nwk",
]
shell = '''
export XDG_CONFIG_HOME="work/qiime2_diversity_tree/xdgconfig"
export MPLCONFIGDIR="work/qiime2_diversity_tree/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_diversity_tree/numbacache"
qiime alignment mafft --i-sequences {input[0]} --o-alignment work/qiime2_diversity_tree/aligned-rep-seqs.qza --p-n-threads {threads}
qiime alignment mask --i-alignment work/qiime2_diversity_tree/aligned-rep-seqs.qza --o-masked-alignment work/qiime2_diversity_tree/masked-aligned-rep-seqs.qza
qiime phylogeny fasttree --i-alignment work/qiime2_diversity_tree/masked-aligned-rep-seqs.qza --p-n-threads {threads} --o-tree work/qiime2_diversity_tree/unrooted-tree.qza
qiime phylogeny midpoint-root --i-tree work/qiime2_diversity_tree/unrooted-tree.qza --o-rooted-tree {output[0]}
qiime tools export --input-path {output[0]} --output-path results/qiime2/phylogenetic_tree
'''
tags = ["qiime2", "diversity"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 6
memory = "6G"

# QIIME2_INTREE_PPLACE: with phylogenetic placement the gappa-grafted
# tree (intermediates/pplace/grafted.newick) is imported as the rooted
# tree for downstream diversity analyses instead of the de-novo
# fasttree path (upstream: ch_intree_pplace feeding QIIME2_TREE's
# rooted-tree output).
[[rules]]
name = "qiime2_intree_pplace"
description = "Import gappa-grafted placement tree as the rooted QIIME2 tree"
when = "config.pplace_tree != \"\" && config.run_qiime2 && !config.skip_qiime && !config.skip_qiime_downstream && (!config.skip_alpha_rarefaction || !config.skip_diversity_indices)"
input = ["intermediates/pplace/grafted.newick"]
output = ["intermediates/qiime2/rooted-tree.qza"]
shell = '''
export MPLCONFIGDIR="work/qiime2_intree_pplace/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_intree_pplace/numbacache"
mkdir -p work/qiime2_intree_pplace
qiime tools import --type 'Phylogeny[Rooted]' --input-path {input[0]} --output-path {output[0]}
'''
tags = ["qiime2", "diversity"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

# QIIME2_ALPHARAREFACTION: max-depth from the overall stats table
# (count_table_minmax_reads.py maximum), capped at 75000; steps =
# 250 (maxdepth > 5000) else maxdepth/20; 10 iterations.
[[rules]]
name = "qiime2_alphararefaction"
description = "QIIME2 alpha-rarefaction curves"
when = "config.run_qiime2 && !config.skip_qiime_downstream && !config.skip_alpha_rarefaction"
input = [
    "{config.metadata_file}",
    "intermediates/qiime2/table.qza",
    "intermediates/qiime2/rooted-tree.qza",
    "results/overall_summary.tsv",
]
output = [
    "results/qiime2/alpha-rarefaction/index.html",
    "results/qiime2/alpha-rarefaction/alpha-rarefaction-shannon.tsv",
    "results/qiime2/alpha-rarefaction/alpha-rarefaction-observed-features.tsv",
    "results/qiime2/alpha-rarefaction/alpha-rarefaction-evenness.tsv",
    "results/qiime2/alpha-rarefaction/alpha-rarefaction-faith-pd.tsv",
]
shell = '''
export XDG_CONFIG_HOME="work/qiime2_alphararefaction/xdgconfig"
export MPLCONFIGDIR="work/qiime2_alphararefaction/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_alphararefaction/numbacache"
maxdepth=$(python3 scripts/count_table_minmax_reads.py {input[3]} maximum)
if [ "$maxdepth" -gt 75000 ]; then maxdepth=75000; fi
if [ "$maxdepth" -gt 5000 ]; then maxsteps=250; else maxsteps=$((maxdepth/20)); fi
qiime diversity alpha-rarefaction --i-table {input[1]} --i-phylogeny {input[2]} --p-max-depth $maxdepth --m-metadata-file {input[0]} --p-steps $maxsteps --p-iterations 10 --o-visualization work/qiime2_alphararefaction/alpha-rarefaction.qzv
qiime tools export --input-path work/qiime2_alphararefaction/alpha-rarefaction.qzv --output-path results/qiime2/alpha-rarefaction
'''
tags = ["qiime2", "diversity"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

# QIIME2_DIVERSITY_CORE: core-metrics-phylogenetic with sampling depth
# = max(min reads of any sample, diversity_rarefaction_depth floor).
# The qza outputs land in intermediates/ (they feed the alpha / beta /
# betaord / adonis rules), the distance matrices are exported as tsv.
[[rules]]
name = "qiime2_diversity_core"
description = "QIIME2 core-metrics-phylogenetic diversity indices"
when = "config.run_qiime2 && !config.skip_qiime_downstream && !config.skip_diversity_indices"
input = [
    "{config.metadata_file}",
    "intermediates/qiime2/table.qza",
    "intermediates/qiime2/rooted-tree.qza",
    "results/overall_summary.tsv",
]
output = [
    "intermediates/qiime2/diversity_core/bray_curtis_distance_matrix.qza",
    "intermediates/qiime2/diversity_core/jaccard_distance_matrix.qza",
    "intermediates/qiime2/diversity_core/unweighted_unifrac_distance_matrix.qza",
    "intermediates/qiime2/diversity_core/weighted_unifrac_distance_matrix.qza",
    "intermediates/qiime2/diversity_core/bray_curtis_pcoa_results.qza",
    "intermediates/qiime2/diversity_core/jaccard_pcoa_results.qza",
    "intermediates/qiime2/diversity_core/unweighted_unifrac_pcoa_results.qza",
    "intermediates/qiime2/diversity_core/weighted_unifrac_pcoa_results.qza",
    "intermediates/qiime2/diversity_core/faith_pd_vector.qza",
    "intermediates/qiime2/diversity_core/observed_features_vector.qza",
    "intermediates/qiime2/diversity_core/shannon_vector.qza",
    "intermediates/qiime2/diversity_core/evenness_vector.qza",
    "results/qiime2/diversity/beta_diversity/bray_curtis_distance_matrix.tsv",
    "results/qiime2/diversity/beta_diversity/jaccard_distance_matrix.tsv",
    "results/qiime2/diversity/beta_diversity/unweighted_unifrac_distance_matrix.tsv",
    "results/qiime2/diversity/beta_diversity/weighted_unifrac_distance_matrix.tsv",
]
shell = '''
# FIX: detecting a viable GPU on your system, but the GPU is unavailable
# for compute, causing UniFrac to fail (upstream comment).
export UNIFRAC_USE_GPU=N
export XDG_CONFIG_HOME="work/qiime2_diversity_core/xdgconfig"
export MPLCONFIGDIR="work/qiime2_diversity_core/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_diversity_core/numbacache"
mkdir -p work/qiime2_diversity_core intermediates/qiime2/diversity_core results/qiime2/diversity/beta_diversity
mindepth=$(python3 scripts/count_table_minmax_reads.py {input[3]} minimum)
if [ "$mindepth" -lt {config.diversity_rarefaction_depth} ]; then mindepth={config.diversity_rarefaction_depth}; fi
qiime diversity core-metrics-phylogenetic --m-metadata-file {input[0]} --i-phylogeny {input[2]} --i-table {input[1]} --p-sampling-depth $mindepth --output-dir work/qiime2_diversity_core/diversity_core --p-n-jobs-or-threads {threads} --verbose
for f in bray_curtis_distance_matrix jaccard_distance_matrix unweighted_unifrac_distance_matrix weighted_unifrac_distance_matrix bray_curtis_pcoa_results jaccard_pcoa_results unweighted_unifrac_pcoa_results weighted_unifrac_pcoa_results faith_pd_vector observed_features_vector shannon_vector evenness_vector; do
    mv work/qiime2_diversity_core/diversity_core/$f.qza intermediates/qiime2/diversity_core/$f.qza
done
for d in bray_curtis_distance_matrix jaccard_distance_matrix unweighted_unifrac_distance_matrix weighted_unifrac_distance_matrix; do
    qiime tools export --input-path intermediates/qiime2/diversity_core/$d.qza --output-path work/qiime2_diversity_core/matrix
    mv work/qiime2_diversity_core/matrix/distance-matrix.tsv results/qiime2/diversity/beta_diversity/$d.tsv
    rm -rf work/qiime2_diversity_core/matrix
done
'''
tags = ["qiime2", "diversity"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 6
memory = "6G"

# QIIME2_DIVERSITY_ALPHA: alpha-group-significance on all four
# diversity vectors (upstream fans the vectors out; the port loops).
[[rules]]
name = "qiime2_diversity_alpha"
description = "QIIME2 alpha diversity group significance tests"
when = "config.run_qiime2 && !config.skip_qiime_downstream && !config.skip_diversity_indices"
input = [
    "{config.metadata_file}",
    "intermediates/qiime2/diversity_core/faith_pd_vector.qza",
    "intermediates/qiime2/diversity_core/observed_features_vector.qza",
    "intermediates/qiime2/diversity_core/shannon_vector.qza",
    "intermediates/qiime2/diversity_core/evenness_vector.qza",
]
output = [
    "results/qiime2/diversity/alpha_diversity/faith_pd_vector/index.html",
    "results/qiime2/diversity/alpha_diversity/observed_features_vector/index.html",
    "results/qiime2/diversity/alpha_diversity/shannon_vector/index.html",
    "results/qiime2/diversity/alpha_diversity/evenness_vector/index.html",
]
shell = '''
export XDG_CONFIG_HOME="work/qiime2_diversity_alpha/xdgconfig"
export MPLCONFIGDIR="work/qiime2_diversity_alpha/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_diversity_alpha/numbacache"
for vec in faith_pd_vector observed_features_vector shannon_vector evenness_vector; do
    qiime diversity alpha-group-significance --i-alpha-diversity intermediates/qiime2/diversity_core/$vec.qza --m-metadata-file {input[0]} --o-visualization work/qiime2_diversity_alpha/$vec-vis.qzv
    qiime tools export --input-path work/qiime2_diversity_alpha/$vec-vis.qzv --output-path results/qiime2/diversity/alpha_diversity/$vec
done
'''
tags = ["qiime2", "diversity"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

# QIIME2_DIVERSITY_BETA: beta-group-significance per distance matrix x
# metadata category (pairwise). The category list is data-dependent
# (default fixture: "group" -> one export dir per distance matrix).
[[rules]]
name = "qiime2_diversity_beta"
description = "QIIME2 beta diversity group significance tests (pairwise)"
when = "config.run_qiime2 && !config.skip_qiime_downstream && !config.skip_diversity_indices"
input = [
    "{config.metadata_file}",
    "intermediates/qiime2/diversity_core/bray_curtis_distance_matrix.qza",
    "intermediates/qiime2/diversity_core/jaccard_distance_matrix.qza",
    "intermediates/qiime2/diversity_core/unweighted_unifrac_distance_matrix.qza",
    "intermediates/qiime2/diversity_core/weighted_unifrac_distance_matrix.qza",
    "intermediates/qiime2/categories_pairwise.txt",
]
output = [
    "results/qiime2/diversity/beta_diversity/bray_curtis_distance_matrix-group/index.html",
    "results/qiime2/diversity/beta_diversity/jaccard_distance_matrix-group/index.html",
    "results/qiime2/diversity/beta_diversity/unweighted_unifrac_distance_matrix-group/index.html",
    "results/qiime2/diversity/beta_diversity/weighted_unifrac_distance_matrix-group/index.html",
]
shell = '''
export XDG_CONFIG_HOME="work/qiime2_diversity_beta/xdgconfig"
export MPLCONFIGDIR="work/qiime2_diversity_beta/mplconfigdir"
export NUMBA_CACHE_DIR="work/qiime2_diversity_beta/numbacache"
CATS=$(cat {input[5]})
if [ -z "$CATS" ]; then
    echo "WARNING: no suitable metadata category found for beta-group-significance" >&2
    exit 0
fi
for dist in bray_curtis_distance_matrix jaccard_distance_matrix unweighted_unifrac_distance_matrix weighted_unifrac_distance_matrix; do
    for cat in $(echo "$CATS" | tr ',' ' '); do
        qiime diversity beta-group-significance --i-distance-matrix intermediates/qiime2/diversity_core/$dist.qza --m-metadata-file {input[0]} --m-metadata-column "$cat" --o-visualization work/qiime2_diversity_beta/$dist-$cat.qzv --p-pairwise
        qiime tools export --input-path work/qiime2_diversity_beta/$dist-$cat.qzv --output-path results/qiime2/diversity/beta_diversity/$dist-$cat
    done
done
'''
tags = ["qiime2", "diversity"]

[rules.environment]
singularity = "docker://quay.io/qiime2/amplicon:2026.1"

[rules.resources]
threads = 2
memory = "3G"

# QIIME2_DIVERSITY_BETAORD: emperor ordination plots per PCoA.
[[rules]]
