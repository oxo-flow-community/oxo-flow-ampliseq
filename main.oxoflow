memory = "2G"

# ------------------------------------------------------------------
# R70  VSEARCH_LCA_CLASSIFY  (nf-core/vsearch/usearchglobal, LCA mode)
#      Global alignment against the reference with LCA taxonomy
#      output (vsearch --usearch_global --lcaout).
# ------------------------------------------------------------------
[[rules]]
name = "vsearch_lca_classify"
description = "VSEARCH global-alignment LCA taxonomy assignment (alternative taxonomy branch)"
when = "config.vsearch_lca_ref_tax_custom != \"\""
input = [
    "results/dada2/ASV_seqs.fasta",
    "intermediates/vsearch_lca/sintaxdb.fa.gz",
]
output = ["intermediates/vsearch_lca/ASV_tax.lca"]
shell = '''
mkdir -p work/vsearch_lca_classify intermediates/vsearch_lca
cp {input[0]} work/vsearch_lca_classify/ASV_tax.fasta
cp {input[1]} work/vsearch_lca_classify/sintaxdb.fa.gz
cd work/vsearch_lca_classify
vsearch --usearch_global ASV_tax.fasta --db sintaxdb.fa.gz --id {config.vsearch_lca_id} --threads {threads} --gzip_decompress --top_hits_only --output_no_hits --maxaccepts {config.vsearch_lca_maxaccepts} --maxrejects {config.vsearch_lca_maxrejects} --lca_cutoff {config.vsearch_lca_lca_cutoff} --query_cov {config.vsearch_lca_query_cov} --n_mismatch --notrunclabels --lcaout ASV_tax.lca
cp ASV_tax.lca "$OLDPWD/intermediates/vsearch_lca/ASV_tax.lca"
'''
tags = ["vsearch", "taxonomy"]

[rules.environment]
singularity = "docker://quay.io/biocontainers/vsearch:2.31.0--hd2be7a0_0"

[rules.resources]
threads = 1
memory = "4G"

# ------------------------------------------------------------------
